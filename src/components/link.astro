---
interface Props {
  href: string;
  disabled?: boolean;
  block?: boolean;
}

const { href = "", disabled = false, block = false } = Astro.props;
---

<a
  href={href}
  class:list={["button", block && "block", disabled && "disabled"]}
>
  <span><slot /></span>
</a>

<style>
  .button {
    --button-border-width: 1px;

    position: relative;
    box-sizing: border-box;
    border: none;
    font: var(--font-button);
    color: var(--white-0);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-radius: 10px;
    height: 60px;
    line-height: 60px;
    padding: 0 49px;
    background-image: linear-gradient(
      180deg,
      #ffc037 0%,
      #f83833 50%,
      #ffc037 100%
    );
    background-position: 0 0;
    background-size: 100% 200%;
    overflow: hidden;
    transition:
      transform var(--transition-short),
      background-position var(--transition) var(--transition-f);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: var(--button-border-width);
      border-radius: inherit;
      background-image: linear-gradient(180deg, #ffa238 0%, #f83833 100%);
      pointer-events: none;
      mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      mask-composite: exclude;
      -webkit-mask:
        linear-gradient(#000 0 0) content-box,
        linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
    }

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
      border-radius: inherit;
      background-image: var(--brand-light-gradient);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition) var(--transition-f);
    }

    &:not(.disabled) {
      @media (hover: hover) {
        cursor: pointer;

        &:hover {
          background-position: 0 100%;
        }
      }

      &:active {
        transform: translateY(1px);
      }
    }

    &.disabled {
      pointer-events: none;

      &::after {
        opacity: 1;
      }
    }

    span {
      position: relative;
      z-index: 3;
    }

    &.block {
      width: 100%;
    }
  }
</style>
