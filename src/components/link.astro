---
interface Props {
  href: string;
  disabled?: boolean;
  block?: boolean;
}

const { href = "", disabled = false, block = false } = Astro.props;
---

<a
  href={href}
  class:list={["button", block && "block", disabled && "disabled"]}
>
  <span><slot /></span>
</a>

<style>
  .button {
    --button-border-width: 1px;

    position: relative;
    box-sizing: border-box;
    border: var(--button-border-width) solid transparent;
    font: var(--font-button);
    color: var(--white-0);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-radius: 10px;
    height: 60px;
    line-height: 60px;
    padding: 0 49px;
    background: linear-gradient(180deg, #ffbe38 0%, #f83833 100%) border-box;
    overflow: hidden;
    transition: transform var(--transition-short);

    &::before {
      content: "";
      position: absolute;
      top: var(--button-border-width);
      right: var(--button-border-width);
      left: var(--button-border-width);
      height: 200%;
      border-radius: calc(10px - var(--button-border-width));
      background-image: linear-gradient(
        180deg,
        #ffc037 0%,
        #f83833 50%,
        #ffc037 100%
      );
      transform: translateY(0);
      transition: transform var(--transition) var(--transition-f);
    }

    &::after {
      content: "";
      position: absolute;
      inset: var(--button-border-width);
      border-radius: calc(10px - var(--button-border-width));
      background-image: var(--brand-light-gradient);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition) var(--transition-f);
    }

    &:not(.disabled) {
      @media (hover: hover) {
        cursor: pointer;

        &:hover {
          &::before {
            transform: translateY(-50%);
          }
        }
      }

      &:active {
        transform: translateY(1px);
      }
    }

    &.disabled {
      pointer-events: none;

      &::after {
        opacity: 1;
      }
    }

    span {
      position: relative;
      z-index: 1;
    }

    &.block {
      width: 100%;
    }
  }
</style>
