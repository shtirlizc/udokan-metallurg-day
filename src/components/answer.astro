---
import type { CollectionEntry } from "astro:content";

interface Props {
  answer: CollectionEntry<"question">["data"]["answers"][number];
  correctAnswerId: string;
}

const { answer, correctAnswerId } = Astro.props;
const { id, text, comment } = answer;
---

<button
  type="button"
  class:list={["answer"]}
  data-number={id}
  data-correct-answer-id={correctAnswerId}
>
  <span class="answer__body">
    <span class="answer__number">
      <span>{id}</span>
    </span>
    <span class="answer__text">{text}</span>
  </span>
  <span class="answer__comment">{comment}</span>
</button>

<style>
  .answer {
    --success-border: #5ff03b;
    --success-bg: #cbfbbf;
    --fail-border: var(--red-accent);
    --fail-bg: #f5c7bb;

    background: none;
    border: none;
    color: var(--black-100);
    text-align: left;
    width: 100%;
    padding: 0;

    &:not(:disabled) {
      cursor: pointer;

      &:hover {
        .answer__body {
          border-color: var(--yellow-orange-accent);

          .answer__number::before {
            transform: scaleX(1.1);
            background-color: var(--yellow-orange-accent);
          }
        }
      }
    }

    &.success {
      .answer__body {
        border: 1px solid var(--success-border) !important;

        .answer__number::before {
          background-color: var(--success-bg) !important;
        }
      }
    }

    &.fail {
      .answer__body {
        border: 1px solid var(--fail-border) !important;

        .answer__number::before {
          background-color: var(--fail-bg) !important;
        }
      }
    }

    & .answer__body {
      display: grid;
      grid-template-columns: 65px 1fr;
      border: 1px solid var(--divider-50);
      background-color: var(--bg-20);
      border-radius: 10px;
      overflow: hidden;
      transition: border var(--transition) var(--transition-f);
    }

    & .answer__number {
      position: relative;
      font: var(--font-answer);
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;

      &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: #fbf2ec;
        transform-origin: left;
        transition:
          transform var(--transition) var(--transition-f),
          background-color var(--transition) var(--transition-f);
      }

      span {
        position: relative;
        z-index: 1;
      }
    }

    & .answer__text {
      font: var(--font-answer);
      padding: var(--space16);
      display: flex;
      align-items: center;

      /* desktop */
      @media (width >= 960px) {
        padding: var(--space24);
      }
    }

    & .answer__comment {
      display: none;
      font: var(--font-answer);
      padding-top: 10px;
      padding-bottom: var(--space16);

      /* desktop */
      @media (width >= 960px) {
        padding-bottom: var(--space20);
      }
    }
  }
</style>
