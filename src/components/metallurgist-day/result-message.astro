---
import Link from "../link.astro";
import LogoIcon from "../../assets/logo-icon.svg";
import type { QuizStorageKey } from "../../config/quizzes";

interface Props {
  questionNumbers: string[];
  excludedQuestionNumbers?: string[];
  storageKey: QuizStorageKey;
}

const {
  questionNumbers,
  storageKey,
  excludedQuestionNumbers = [],
} = Astro.props;
const questionsCount = questionNumbers.length;
---

<div
  class="message"
  id="result-message"
  data-question-numbers={JSON.stringify(questionNumbers)}
  data-excluded-question-numbers={JSON.stringify(excludedQuestionNumbers)}
  data-quiz-storage-key={storageKey}
>
  <div class="message__body">
    <div class="message__result">
      <ul class="message__result-chart">
        {
          Array.from({
            length: questionsCount - excludedQuestionNumbers.length,
          }).map(() => (
            <li>
              <LogoIcon />
            </li>
          ))
        }
      </ul>
      <p class="message__result-legend"></p>
    </div>

    <p class="message__text"></p>
  </div>

  <Link href="/день-металлурга/" block>Пройти ещё раз</Link>
</div>

<script>
  import { withBase } from "../../utils/paths";
  import { gsap } from "gsap";
  import { navigate } from "astro:transitions/client";
  import { readStoredQuizResult } from "../../scripts/quiz-result";

  const RESULT_C =
    "Всё начинается с первого шага — рады, что вы с нами! Вместе у нас всё получится!";
  const RESULT_B =
    "Ещё немного, и вас будет не догнать! Поздравляем, вы истинный удоканец!";
  const RESULT_A =
    "Вы — хранитель наших ценностей и традиций. Поздравляем с праздником и напоминаем — мы гордимся работать с вами в одной команде!";

  const messageTexts = new Map<number, string>();
  messageTexts.set(1, RESULT_C);
  messageTexts.set(2, RESULT_C);
  messageTexts.set(3, RESULT_C);
  messageTexts.set(4, RESULT_B);
  messageTexts.set(5, RESULT_B);
  messageTexts.set(6, RESULT_A);
  messageTexts.set(7, RESULT_A);

  function initCurrentResultMessage() {
    const resultMessage = document.getElementById("result-message");

    if (!resultMessage || resultMessage.dataset.initialized === "true") return;

    resultMessage.dataset.initialized = "true";
    initResultMessage(resultMessage);
  }

  document.addEventListener("astro:page-load", initCurrentResultMessage);

  function initResultMessage(resultMessage: HTMLElement) {
    const questionNumbers: string[] = JSON.parse(
      resultMessage.dataset.questionNumbers ?? "[]",
    );
    const storageKey = resultMessage.dataset.quizStorageKey;
    const restartLink = resultMessage.querySelector<HTMLAnchorElement>("a");

    if (!storageKey) return;

    const excludedQuestionNumbers: string[] = JSON.parse(
      resultMessage.dataset.excludedQuestionNumbers ?? "[]",
    );
    const result = readStoredQuizResult(
      storageKey,
      questionNumbers,
      excludedQuestionNumbers,
    );

    restartLink?.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const isIOS =
        /iP(ad|hone|od)/.test(navigator.userAgent) ||
        (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

      if (isIOS) {
        event.preventDefault();
        navigate(restartLink.href);
        return;
      }

      event.preventDefault();
      if (resultMessage.classList.contains("is-leaving")) return;
      resultMessage.classList.add("is-leaving");

      let navigated = false;
      let fallback: number | undefined;
      const onTransitionEnd = (transitionEvent: TransitionEvent) => {
        if (transitionEvent.propertyName === "opacity") restart();
      };
      const restart = () => {
        if (navigated) return;
        navigated = true;
        if (fallback) clearTimeout(fallback);
        resultMessage.removeEventListener("transitionend", onTransitionEnd);
        navigate(restartLink.href);
      };

      resultMessage.addEventListener("transitionend", onTransitionEnd);
      fallback = window.setTimeout(restart, 500);
    });

    if (!result) {
      goHome();
      return;
    }

    showResult(
      result.correctAnswersCount,
      `${result.correctAnswersCount}/${result.totalAnswers} правильных ответов`,
      messageTexts.get(result.correctAnswersCount) ?? RESULT_C,
    );

    function goHome() {
      navigate(withBase("/день-металлурга/"), { history: "replace" });
    }

    function showResult(
      correctAnswersCount: number,
      legendText: string,
      message: string,
    ) {
      const icons = Array.from(
        resultMessage.querySelectorAll<HTMLElement>(
          ".message__result-chart li",
        ),
      );
      const legendEl = resultMessage.querySelector(".message__result-legend");
      const messageEl = resultMessage.querySelector(".message__text");

      if (legendEl && messageEl) {
        legendEl.textContent = legendText;
        messageEl.textContent = message;

        const revealDelay = document.documentElement.hasAttribute(
          "data-astro-transition",
        )
          ? 1_500
          : 0;

        setTimeout(() => {
          resultMessage.classList.add("is-open");

          setTimeout(() => {
            const correctIcons = icons.slice(0, correctAnswersCount);

            gsap.set(icons, { opacity: 0.5, scale: 1 });
            gsap.to(correctIcons, {
              keyframes: [
                {
                  opacity: 1,
                  scale: 1.3,
                  duration: 0.25,
                  ease: "back.out(2)",
                },
                {
                  scale: 1,
                  duration: 0.2,
                  ease: "power2.out",
                },
              ],
              stagger: 0.1,
            });
          }, 300);
        }, revealDelay);
      }
    }
  }
</script>

<style>
  .message {
    display: grid;
    grid-template-rows: 1fr auto;
    text-align: center;
    inset: 0;
    width: fit-content;
    height: fit-content;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background-color: transparent;
    color: var(--black-100);
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity var(--transition-long) var(--transition-f),
      transform var(--transition-long) var(--transition-f);

    &.is-open {
      visibility: visible;
      pointer-events: auto;
      opacity: 1;
      transform: scale(1);
    }

    &.is-open.is-leaving {
      opacity: 0;
      transform: scale(0.75);
    }

    /* desktop */
    @media (width >= 960px) {
      aspect-ratio: 473 / 418;
    }
  }

  @starting-style {
    .message.is-open {
      opacity: 0;
      transform: scale(0.75);
    }
  }

  .message__body {
    margin-bottom: var(--space40);
  }

  .message__result {
    & .message__result-chart {
      list-style: none;
      padding: 0;
      display: flex;
      justify-content: center;

      @media (width < 390px) {
        margin-bottom: var(--space16);
      }

      li {
        width: var(--space48);
        height: var(--space48);
        opacity: 0.5;
        display: flex;
        justify-content: center;
        align-items: center;

        @media (width < 390px) {
          width: var(--space36);
          height: var(--space36);
        }
      }
    }

    & .message__result-legend {
      font: var(--font-text-medium);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space);
      }
    }
  }

  .message__text {
    margin: var(--space16) 0;
    font: var(--font-result);
  }
</style>
