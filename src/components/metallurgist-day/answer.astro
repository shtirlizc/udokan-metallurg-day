---
import type { QuizAnswer } from "../../types/quiz";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
  answer: QuizAnswer;
  correctAnswerId: string;
  customComponent?: AstroComponentFactory;
}

const {
  answer,
  correctAnswerId,
  customComponent: CustomComponent,
} = Astro.props;
const { id, text, comment } = answer;
---

<button
  type="button"
  class:list={["answer"]}
  data-number={id}
  data-correct-answer-id={correctAnswerId}
>
  <span
    class:list={["answer__body", { "answer__body--custom": CustomComponent }]}
  >
    {
      CustomComponent ? (
        <CustomComponent answer={answer} correctAnswerId={correctAnswerId} />
      ) : (
        <>
          <span class="answer__number">
            <span>{id}</span>
          </span>
          <span class="answer__text">{text}</span>
        </>
      )
    }
  </span>
  <span class="answer__comment">{comment}</span>
</button>

<style>
  .answer {
    --fail-border: var(--red-accent);
    --fail-bg: #f5c7bb;
    --active-color: var(--answer-active-color, var(--yellow-orange-accent));
    --active-text-color: var(--answer-active-text-color, currentcolor);
    --disabled-color: var(--answer-disabled-color, #fbf2ec);

    background: none;
    border: none;
    color: var(--black-100);
    text-align: left;
    width: 100%;
    padding: 0;

    &:focus-visible {
      outline: 2px solid var(--black-100);
      outline-offset: 3px;
      border-radius: 10px;
    }

    &:not(:disabled) {
      cursor: pointer;

      @media (hover: hover) {
        .answer__body:not(.answer__body--custom):hover {
          border-color: var(--active-color);

          .answer__number {
            color: var(--active-text-color);

            &::before {
              transform: scaleX(1.1);
              background-color: var(--active-color);
            }
          }
        }
      }
    }

    &.success {
      --success-border: #5ff03b;
      --success-bg: #cbfbbf;

      .answer__body {
        border: 1px solid var(--success-border) !important;

        .answer__number::before {
          background-color: var(--success-bg) !important;
        }
      }
    }

    &.fail {
      .answer__body {
        border: 1px solid var(--fail-border) !important;

        .answer__number::before {
          background-color: var(--fail-bg) !important;
        }
      }
    }

    & .answer__body--custom {
      display: block;
    }

    &:disabled .answer__body--custom {
      pointer-events: none;
    }

    & .answer__body:not(.answer__body--custom) {
      display: grid;
      grid-template-columns: 74px 1fr;
      border: 1px solid var(--divider-50);
      background-color: var(--bg-20);
      border-radius: 10px;
      overflow: hidden;
      transition: border var(--transition) var(--transition-f);
    }

    & .answer__number {
      position: relative;
      font: var(--font-answer);
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      transition: color var(--transition) var(--transition-f);

      &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: var(--disabled-color);
        transform-origin: left;
        transition:
          transform var(--transition) var(--transition-f),
          background-color var(--transition) var(--transition-f);
      }

      span {
        position: relative;
        z-index: 1;
      }
    }

    & .answer__text {
      font: var(--font-answer);
      padding: 15px var(--space16);
      display: flex;
      align-items: center;

      /* desktop */
      @media (width >= 960px) {
        padding: 22px var(--space24);
      }
    }

    & .answer__comment {
      display: none;
      font: var(--font-answer);
      padding-top: 10px;
      padding-bottom: 10px;

      /* desktop */
      @media (width >= 960px) {
        padding-bottom: var(--space20);
      }
    }
  }
</style>
