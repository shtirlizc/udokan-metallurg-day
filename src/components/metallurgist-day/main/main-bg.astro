---
import { getImage, Image } from "astro:assets";

import bgDesktopImg from "./assets/bg-desktop.webp";
import bgMobileImg from "./assets/bg-mobile.webp";
import blueImg from "./assets/blue.webp";
import cloudsImg from "./assets/clouds.webp";
import forestImg from "./assets/forest.webp";

const [mobileBackground, desktopBackground] = await Promise.all([
  getImage({ src: bgMobileImg, widths: [375, 750] }),
  getImage({ src: bgDesktopImg, widths: [1438, 2876] }),
]);
---

<div class="bg">
  <picture class="bg__image">
    <source
      media="(min-width: 960px)"
      srcset={desktopBackground.srcSet.attribute}
      sizes="100vw"
      type="image/webp"
    />
    <img
      src={mobileBackground.src}
      srcset={mobileBackground.srcSet.attribute}
      sizes="100vw"
      {...mobileBackground.attributes}
      alt=""
    />
  </picture>
  <Image
    class="blue"
    src={blueImg}
    widths={[1440, 2880]}
    sizes="100vw"
    alt=""
  />
  <div class="clouds">
    <Image src={cloudsImg} widths={[2971, 5942]} sizes="200vw" alt="" />
  </div>
  <Image
    class="forest"
    src={forestImg}
    widths={[1440, 2880]}
    sizes="100vw"
    alt=""
  />
</div>

<script>
  const forest = document.querySelector<HTMLImageElement>(".forest");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (forest && !reducedMotion.matches) {
    let frame: number | null = null;

    const moveForest = (event: PointerEvent) => {
      const x = (event.clientX / window.innerWidth - 0.5) * -16;
      const y = (event.clientY / window.innerHeight - 0.5) * -10;

      if (frame !== null) {
        cancelAnimationFrame(frame);
      }

      frame = requestAnimationFrame(() => {
        forest.style.setProperty("--forest-x", `${x}px`);
        forest.style.setProperty("--forest-y", `${y}px`);
        frame = null;
      });
    };

    window.addEventListener("pointermove", moveForest, { passive: true });
    window.addEventListener("pointerleave", () => {
      forest.style.setProperty("--forest-x", "0px");
      forest.style.setProperty("--forest-y", "0px");
    });
  }
</script>

<style>
  .bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;

    .bg__image {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 45%;
      opacity: 0.7;
      background-image: linear-gradient(
        0deg,
        #201d39 0%,
        rgba(47, 43, 79, 0) 100%
      );
    }

    .blue {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: auto;
    }

    .clouds {
      position: absolute;
      inset: 0;
      overflow: hidden;

      img {
        width: auto;
        max-height: 85vh;
        animation: clouds 150s linear both;
      }
    }

    .forest {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: auto;
      display: none;
      transform: translate(var(--forest-x, 0), var(--forest-y, 0)) scale(1.025);
      transition: transform 300ms ease-out;
      will-change: transform;

      /* desktop */
      @media (width >= 960px) {
        display: block;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg .forest {
      transform: none;
      transition: none;
    }
  }

  @keyframes clouds {
    from {
      transform: translate(0);
    }

    to {
      transform: translate(-100%);
    }
  }
</style>
