---
interface Props {
  href: string;
  disabled?: boolean;
  block?: boolean;
  view?: "default" | "react" | "round";
}

const {
  href = "",
  disabled = false,
  block = false,
  view = "default",
} = Astro.props;
---

<a
  href={disabled ? undefined : href}
  data-href={disabled ? href : undefined}
  class:list={[
    "button",
    block && "block",
    view !== "default" ? `view--${view}` : "",
  ]}
>
  <span><slot /></span>
  <span class="button__loading-shine" aria-hidden="true"></span>
</a>

<style>
  .button {
    position: relative;
    border: none;
    font: var(--font-button);
    color: var(--white-0);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border-radius: 10px;
    height: 60px;
    line-height: 60px;
    padding: 0 89px;
    overflow: hidden;
    transition:
      transform var(--transition-short),
      color var(--transition-short);

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 200%;
      background-image: var(--link-bg);
      transform: translateY(0);
      transition: transform var(--transition) var(--transition-f);
    }

    &::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: var(--brand-light-gradient);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition) var(--transition-f);
    }

    &[href] {
      @media (hover: hover) {
        cursor: pointer;

        &:hover {
          &::before {
            transform: translateY(-50%);
          }
        }
      }

      &:active {
        transform: translateY(1px);
      }
    }

    &:not([href]) {
      pointer-events: none;

      &::after {
        opacity: 1;
      }
    }

    &.loading {
      pointer-events: none;
      cursor: progress;
      color: rgba(255, 255, 255, 0.5);

      .button__loading-shine {
        opacity: 1;
        animation: button-loading-shine 1.4s ease-in-out infinite;
      }
    }

    span {
      position: relative;
      z-index: 1;
    }

    & .button__loading-shine {
      position: absolute;
      z-index: 2;
      top: -50%;
      left: 0;
      width: 28%;
      height: 200%;
      pointer-events: none;
      opacity: 0;
      background: linear-gradient(
        90deg,
        transparent,
        rgb(255 255 255 / 0.08) 30%,
        rgb(255 255 255 / 0.52) 50%,
        rgb(255 255 255 / 0.08) 70%,
        transparent
      );
      transform: translateX(-180%) skewX(-18deg);
    }

    &.view--rect {
      border-radius: 0;
    }

    &.view--round {
      border-radius: 80px;
    }

    &.block {
      width: 100%;
      padding: 0 20px;
    }
  }

  @keyframes button-loading-shine {
    from {
      transform: translateX(-180%) skewX(-18deg);
    }

    to {
      transform: translateX(520%) skewX(-18deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button.loading .button__loading-shine {
      animation: none;
      transform: translateX(180%) skewX(-18deg);
    }
  }
</style>
