---
import Link from "../link.astro";
import type { QuizStorageKey } from "../../config/quizzes";
import type { QuizAnswer, QuizQuestion } from "../../types/quiz";
import Answer from "./answer.astro";

interface Props {
  question: QuizQuestion;
  storageKey: QuizStorageKey;
  nextLinkView?: "default" | "rect";
}

const { question, storageKey, nextLinkView = "default" } = Astro.props;
const {
  questionNumber,
  questionText,
  correctAnswerId,
  answers,
  nextPage,
  isLast = false,
} = question.data;
const quizBasePaths: Record<QuizQuestion["collection"], string> = {
  metallurgistQuestions: "/день-металлурга",
  safetyQuestions: "/безопасность",
};
const nextPageHref = `${quizBasePaths[question.collection]}/${nextPage}`;
---

<div
  class="quiz"
  data-question-number={questionNumber}
  data-quiz-storage-key={storageKey}
>
  <span class="quiz__scroll-cue" aria-hidden="true"></span>
  <div class="quiz__head">
    <h2>Вопрос {questionNumber}</h2>
    <p>
      {questionText}
    </p>
  </div>

  <ul class="quiz__body">
    {
      answers.map((answer: QuizAnswer) => {
        return (
          <li>
            <Answer answer={answer} correctAnswerId={correctAnswerId} />
          </li>
        );
      })
    }
  </ul>

  <div class="quiz__next">
    <Link href={nextPageHref} block disabled view={nextLinkView}>
      {isLast ? "Получить результаты" : "Следующий вопрос"}
    </Link>
  </div>
</div>

<style>
  .quiz {
    position: relative;
    background-color: var(--white-0);
    border-radius: var(--quiz-border-radius);
    z-index: 1;
    min-height: 100%;
    display: flex;
    flex-direction: column;

    @media (prefers-reduced-motion: no-preference) {
      & .quiz__scroll-cue {
        animation: quiz-scroll-cue 1.6s ease-in-out infinite;
        will-change: transform, opacity;
      }
    }

    /* desktop */
    @media (width >= 960px) {
      & .quiz__scroll-cue {
        display: none;
      }
    }

    & .quiz__scroll-cue {
      position: absolute;
      top: var(--space8);
      right: var(--space16);
      z-index: 1;
      width: 18px;
      height: 24px;
      pointer-events: none;
      opacity: 0.7;

      &::before,
      &::after {
        content: "";
        position: absolute;
        left: 5px;
        width: 8px;
        height: 8px;
        border-right: 2px solid currentcolor;
        border-bottom: 2px solid currentcolor;
        transform: rotate(45deg);
      }

      &::before {
        top: 3px;
      }

      &::after {
        top: 10px;
      }
    }

    & .quiz__head {
      padding: var(--space20) var(--space16) 0;

      /* desktop */
      @media (width >= 960px) {
        padding: var(--space32) var(--space32) 0;
      }

      h2 {
        font: var(--font-title-2);
      }

      p {
        margin-top: var(--space16);
        font: var(--font-text-medium);

        /* desktop */
        @media (width >= 960px) {
          margin-top: var(--space32);
        }
      }
    }

    & .quiz__body {
      margin-top: var(--space12);
      margin-bottom: var(--space40);
      list-style: none;
      display: grid;
      gap: var(--space);
      padding: 0 var(--space16);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space24);
        gap: var(--space8);
        padding: 0 var(--space32);
      }
    }

    & .quiz__next {
      margin-top: auto;
      margin-bottom: 0;
      padding: var(--quiz-next-padding);
    }
  }

  @keyframes quiz-scroll-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.35;
    }

    45% {
      transform: translateY(6px);
      opacity: 0.85;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { navigate } from "astro:transitions/client";

  type AnswerType = "success" | "fail";

  function initQuiz() {
    const quiz = document.querySelector<HTMLElement>(".quiz");

    if (!quiz) return;

    const questionNumber = quiz.dataset.questionNumber;
    const storageKey = quiz.dataset.quizStorageKey;
    const nextLink = quiz.querySelector<HTMLAnchorElement>("a");

    if (!nextLink || !questionNumber || !storageKey) return;

    // On browser back/forward Astro can preserve the previous DOM, so this
    // check must run before the initialization guard on every page load.
    if (hasSavedAnswer(storageKey, questionNumber)) {
      const nextHref = nextLink.dataset.href ?? nextLink.href;
      navigate(nextHref, { history: "replace" });
      return;
    }

    if (quiz.dataset.initialized === "true") return;

    quiz.dataset.initialized = "true";

    nextLink.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        !nextLink.hasAttribute("href")
      ) {
        return;
      }

      quiz.closest(".quiz-panel")?.classList.add("loading");
      nextLink.classList.add("loading");
      nextLink.setAttribute("aria-busy", "true");
    });

    const answers = quiz.querySelectorAll<HTMLButtonElement>("button");
    answers.forEach((answer) => {
      answer.addEventListener("click", () => {
        const answerId = answer.dataset.number;
        const correctAnswerId = answer.dataset.correctAnswerId;

        if (!answerId || !correctAnswerId) {
          console.error("answerId and correctAnswerId are required");
          return;
        }

        const answerType: AnswerType =
          answerId === correctAnswerId ? "success" : "fail";

        answer.classList.add(answerType);
        saveToStorage(storageKey, questionNumber, answerType);
        disableAnswerButtons(answers);
        activateNextLink(nextLink);
        showComment(answer).eventCallback("onComplete", scrollToQuizBottom);
        answerAnimation(answerType, answer);
      });
    });
  }

  document.addEventListener("astro:page-load", initQuiz);

  function hasSavedAnswer(storageKey: string, questionId: string) {
    try {
      const savedAnswers = sessionStorage.getItem(storageKey);

      if (!savedAnswers) return false;

      const answers: unknown = JSON.parse(savedAnswers);

      return (
        answers !== null &&
        typeof answers === "object" &&
        !Array.isArray(answers) &&
        Object.hasOwn(answers, questionId)
      );
    } catch {
      return false;
    }
  }

  function saveToStorage(
    storageKey: string,
    questionId: string,
    answerType: AnswerType,
  ) {
    try {
      const savedAnswers = sessionStorage.getItem(storageKey);
      let answers: Record<string, AnswerType> = {};

      if (savedAnswers) {
        try {
          const parsedAnswers = JSON.parse(savedAnswers);

          if (
            parsedAnswers &&
            typeof parsedAnswers === "object" &&
            !Array.isArray(parsedAnswers)
          ) {
            answers = parsedAnswers;
          }
        } catch {
          answers = {};
        }
      }

      answers[questionId] = answerType;
      sessionStorage.setItem(storageKey, JSON.stringify(answers));
    } catch {
      // Continue the quiz when storage is unavailable.
    }
  }

  function disableAnswerButtons(answers: NodeListOf<HTMLButtonElement>) {
    answers.forEach((answer) => {
      answer.disabled = true;
    });
  }

  function activateNextLink(nextLink: HTMLAnchorElement) {
    const href = nextLink.dataset.href;

    if (!href) return;

    nextLink.setAttribute("href", href);
  }

  function scrollToQuizBottom() {
    if (!window.matchMedia("(max-width: 959px)").matches) return;

    requestAnimationFrame(() => {
      const scrollContainer =
        document.querySelector<HTMLElement>(".quiz-panel");

      scrollContainer?.scrollTo({
        top: scrollContainer.scrollHeight,
        behavior: "smooth",
      });
    });
  }

  function showComment(answer: HTMLButtonElement) {
    const comment = answer.querySelector(".answer__comment");

    const tl = gsap.timeline();
    return tl
      .set(comment, {
        display: "block",
        height: 0,
        opacity: 0,
        overflow: "hidden",
      })
      .to(comment, {
        height: "auto",
        opacity: 1,
        duration: 0.4,
        ease: "back.out",
      });
  }

  function answerAnimation(answerType: AnswerType, answer: HTMLButtonElement) {
    const answerBody = answer.querySelector<HTMLElement>(".answer__body");

    if (!answerBody) return;

    gsap.killTweensOf(answerBody);

    if (answerType === "success") {
      gsap
        .timeline({ defaults: { ease: "power2.out" } })
        .set(answerBody, {
          transformOrigin: "50% 50%",
          x: 0,
          rotate: 0,
          scale: 1,
        })
        .to(answerBody, {
          scale: 1.04,
          rotate: -1.5,
          duration: 0.18,
        })
        .to(answerBody, {
          scale: 0.98,
          rotate: 1.5,
          duration: 0.15,
        })
        .to(answerBody, {
          scale: 1.02,
          rotate: -0.8,
          duration: 0.15,
        })
        .to(answerBody, {
          scale: 1,
          rotate: 0,
          duration: 0.27,
          ease: "back.out(2)",
        });

      return;
    }

    gsap.fromTo(
      answerBody,
      { x: 0 },
      {
        keyframes: [
          { x: -10, duration: 0.09 },
          { x: 8, duration: 0.09 },
          { x: -6, duration: 0.09 },
          { x: 4, duration: 0.09 },
          { x: -2, duration: 0.075 },
          { x: 0, duration: 0.075 },
        ],
        ease: "power2.out",
      },
    );
  }
</script>
