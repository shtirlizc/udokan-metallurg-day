---
import Link from "./link.astro";
import type { CollectionEntry } from "astro:content";
import Answer from "./answer.astro";

interface Props {
  question: CollectionEntry<"question">;
}

type QuestionAnswer = CollectionEntry<"question">["data"]["answers"][number];

const { question } = Astro.props;
const {
  questionNumber,
  questionText,
  correctAnswerId,
  answers,
  nextPage,
  isLast = false,
} = question.data;
---

<div class="quiz" data-question-number={questionNumber}>
  <span class="quiz__scroll-cue" aria-hidden="true"></span>
  <div class="quiz__head">
    <h2>Вопрос {questionNumber}</h2>
    <p>
      {questionText}
    </p>
  </div>

  <ul class="quiz__body">
    {
      answers.map((answer: QuestionAnswer) => {
        return (
          <li>
            <Answer answer={answer} correctAnswerId={correctAnswerId} />
          </li>
        );
      })
    }
  </ul>

  <div class="quiz__next">
    <Link href={`/день-металлурга/${nextPage}`} block disabled>
      {isLast ? "Получить результаты" : "Следующий вопрос"}
    </Link>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { navigate } from "astro:transitions/client";

  type AnswerType = "success" | "fail";

  function initQuiz() {
    const quiz = document.querySelector<HTMLElement>(".quiz");

    if (!quiz) return;

    const questionNumber = quiz.dataset.questionNumber;
    const nextLink = quiz.querySelector<HTMLAnchorElement>("a");

    if (!nextLink || !questionNumber) return;

    // On browser back/forward Astro can preserve the previous DOM, so this
    // check must run before the initialization guard on every page load.
    if (hasSavedAnswer(questionNumber)) {
      navigate(nextLink.href, { history: "replace" });
      return;
    }

    if (quiz.dataset.initialized === "true") return;

    quiz.dataset.initialized = "true";

    nextLink.addEventListener("click", (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey ||
        nextLink.classList.contains("disabled")
      ) {
        return;
      }

      quiz.closest(".quiz-panel")?.classList.add("loading");
      nextLink.classList.add("loading");
      nextLink.setAttribute("aria-busy", "true");
    });

    const answers = quiz.querySelectorAll<HTMLButtonElement>("button");
    answers.forEach((answer) => {
      answer.addEventListener("click", () => {
        const answerId = answer.dataset.number;
        const correctAnswerId = answer.dataset.correctAnswerId;

        if (!answerId || !correctAnswerId) {
          console.error("answerId and correctAnswerId are required");
          return;
        }

        const answerType: AnswerType =
          answerId === correctAnswerId ? "success" : "fail";

        answer.classList.add(answerType);
        saveToStorage(questionNumber, answerType);
        disableAnswerButtons(answers);
        activateNextLink(nextLink);
        showComment(answer).eventCallback("onComplete", scrollToQuizBottom);
        answerAnimation(answerType, answer);
      });
    });
  }

  document.addEventListener("astro:page-load", initQuiz);

  function hasSavedAnswer(questionId: string) {
    const savedAnswers = sessionStorage.getItem("udokan_quiz");

    if (!savedAnswers) return false;

    try {
      const answers: unknown = JSON.parse(savedAnswers);

      return (
        answers !== null &&
        typeof answers === "object" &&
        !Array.isArray(answers) &&
        Object.hasOwn(answers, questionId)
      );
    } catch {
      return false;
    }
  }

  function saveToStorage(questionId: string, answerType: AnswerType) {
    const KEY = "udokan_quiz";
    const savedAnswers = sessionStorage.getItem(KEY);

    let answers: Record<string, AnswerType> = {};

    if (savedAnswers) {
      try {
        const parsedAnswers = JSON.parse(savedAnswers);

        if (
          parsedAnswers &&
          typeof parsedAnswers === "object" &&
          !Array.isArray(parsedAnswers)
        ) {
          answers = parsedAnswers;
        }
      } catch {
        answers = {};
      }
    }

    answers[questionId] = answerType;
    sessionStorage.setItem(KEY, JSON.stringify(answers));
  }

  function disableAnswerButtons(answers: NodeListOf<HTMLButtonElement>) {
    answers.forEach((answer) => {
      answer.disabled = true;
    });
  }

  function activateNextLink(nextLink: HTMLAnchorElement) {
    nextLink.classList.remove("disabled");
  }

  function scrollToQuizBottom() {
    if (!window.matchMedia("(max-width: 959px)").matches) return;

    requestAnimationFrame(() => {
      const scrollContainer = document.querySelector<HTMLElement>(".quiz");

      scrollContainer?.scrollTo({
        top: scrollContainer.scrollHeight,
        behavior: "smooth",
      });
    });
  }

  function showComment(answer: HTMLButtonElement) {
    const comment = answer.querySelector(".answer__comment");

    const tl = gsap.timeline();
    return tl
      .set(comment, {
        display: "block",
        height: 0,
        opacity: 0,
        overflow: "hidden",
      })
      .to(comment, {
        height: "auto",
        opacity: 1,
        duration: 0.4,
        ease: "back.out",
      });
  }

  function answerAnimation(answerType: AnswerType, answer: HTMLButtonElement) {
    const answerBody = answer.querySelector<HTMLElement>(".answer__body");

    if (!answerBody) return;

    gsap.killTweensOf(answerBody);

    if (answerType === "success") {
      gsap
        .timeline({ defaults: { ease: "power2.out" } })
        .set(answerBody, {
          transformOrigin: "50% 50%",
          x: 0,
          rotate: 0,
          scale: 1,
        })
        .to(answerBody, {
          scale: 1.04,
          rotate: -1.5,
          duration: 0.18,
        })
        .to(answerBody, {
          scale: 0.98,
          rotate: 1.5,
          duration: 0.15,
        })
        .to(answerBody, {
          scale: 1.02,
          rotate: -0.8,
          duration: 0.15,
        })
        .to(answerBody, {
          scale: 1,
          rotate: 0,
          duration: 0.27,
          ease: "back.out(2)",
        });

      return;
    }

    gsap.fromTo(
      answerBody,
      { x: 0 },
      {
        keyframes: [
          { x: -10, duration: 0.09 },
          { x: 8, duration: 0.09 },
          { x: -6, duration: 0.09 },
          { x: 4, duration: 0.09 },
          { x: -2, duration: 0.075 },
          { x: 0, duration: 0.075 },
        ],
        ease: "power2.out",
      },
    );
  }
</script>

<style>
  .quiz {
    position: relative;
    background-color: var(--white-0);
    border-radius: var(--border-radius12) var(--border-radius12) 0 0;
    z-index: 1;
    height: 100%;
    min-height: 0;
    padding: var(--space20) var(--space16);
    overflow-x: hidden;
    overflow-y: auto;
    display: flex;
    flex-direction: column;

    & .quiz__scroll-cue {
      position: absolute;
      top: var(--space8);
      right: var(--space16);
      z-index: 1;
      width: 18px;
      height: 24px;
      pointer-events: none;
      opacity: 0.7;

      &::before,
      &::after {
        content: "";
        position: absolute;
        left: 5px;
        width: 8px;
        height: 8px;
        border-right: 2px solid currentcolor;
        border-bottom: 2px solid currentcolor;
        transform: rotate(45deg);
      }

      &::before {
        top: 3px;
      }

      &::after {
        top: 10px;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      & .quiz__scroll-cue {
        animation: quiz-scroll-cue 1.6s ease-in-out infinite;
        will-change: transform, opacity;
      }
    }

    /* desktop */
    @media (width >= 960px) {
      border-radius: 24px;
      padding: var(--space32);

      & .quiz__scroll-cue {
        display: none;
      }
    }

    & .quiz__head {
      h2 {
        font: var(--font-title-2);
      }

      p {
        margin-top: var(--space16);
        font: var(--font-text-medium);

        /* desktop */
        @media (width >= 960px) {
          margin-top: var(--space32);
        }
      }
    }

    & .quiz__body {
      margin-top: var(--space12);
      margin-bottom: var(--space40);
      list-style: none;
      padding: 0;
      display: grid;
      gap: var(--space);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space24);
        gap: var(--space8);
      }
    }

    & .quiz__next {
      margin-top: auto;
      margin-bottom: 0;
    }
  }

  @keyframes quiz-scroll-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.35;
    }

    45% {
      transform: translateY(6px);
      opacity: 0.85;
    }
  }
</style>
