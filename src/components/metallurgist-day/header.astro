---
import Logo from "../logo.astro";

interface Props {
  isCentered?: boolean;
}

const { isCentered = false } = Astro.props;
---

<header class:list={[`header`, isCentered && "isCentered"]}>
  <div class="logo">
    <Logo />
  </div>
</header>

<style>
  .header {
    position: relative;
    padding: var(--space20) var(--space8) 0;
    z-index: 1;

    &.isCentered {
      display: flex;
      justify-content: center;

      /* desktop */
      @media (width >= 960px) {
        justify-content: space-between;
      }
    }

    /* desktop */
    @media (width >= 960px) {
      padding: var(--space20) var(--space20) 0;
    }

    .logo {
      /* desktop */
      @media (width >= 960px) {
        height: 49px;
      }

      svg {
        width: 75.6px;
        height: auto;

        /* desktop */
        @media (width >= 960px) {
          width: 126px;
        }
      }
    }
  }
</style>
