---
const practices = [
  "Обязательные инструктажи по охране труда",
  "Система 5S",
  "Модуль «Безопасность» на корпоративном портале",
  "Право отказаться от небезопасной работы",
  "Инвестиции в охрану труда и промышленную безопасность",
];
---

<section class="evidence" id="practices" aria-labelledby="evidence-title">
  <div class="evidence__inner">
    <h2 id="evidence-title">5 доказательств, что забота о безопасности встроена в работу Удокана</h2>
    <p class="evidence__lead">
      Культура складывается из повторяющихся действий и обязательных инструментов.
    </p>
    <ul>
      {practices.map((practice) => (
        <li>
          <div class="evidence__image" aria-hidden="true"></div>
          <h3>{practice}</h3>
          <p>Описание практики будет добавлено.</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .evidence {
    padding: 72px 20px;
    background: #f4f7fa;
  }

  .evidence__inner {
    width: min(100%, 1040px);
    margin-inline: auto;
  }

  h2 {
    max-width: 700px;
    margin: 0 auto;
    font-size: 30px;
    line-height: 1.08;
    text-align: center;
  }

  .evidence__lead {
    max-width: 680px;
    margin: 14px auto 28px;
    font-size: 14px;
    text-align: center;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 10px;
    border: 1px solid #d1d9e0;
    background: var(--white-0);
  }

  .evidence__image {
    aspect-ratio: 1.55;
    background: #cbd6de;
  }

  h3 {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.25;
  }

  li p {
    margin: 8px 0 0;
    color: #596572;
    font-size: 13px;
    line-height: 1.45;
  }
</style>