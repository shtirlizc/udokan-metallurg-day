---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="hero" aria-labelledby="article-title">
  <div class="hero__inner">
    <p class="hero__eyebrow">Кодекс Удокана</p>
    <h1 id="article-title">{title}</h1>
    <p class="hero__text">
      Безопасность работников и производственных процессов — общий приоритет и
      ответственность каждого.
    </p>
    <a class="hero__link" href="#risk-scenarios">
      Разобраться на примерах <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 440px;
    padding: 64px max(20px, calc((100% - 1120px) / 2));
    background: #102b42;
    color: var(--color-white);

    @media (width >= 960px) {
      min-height: 540px;
    }
  }

  .hero__inner {
    max-width: 470px;
  }

  .hero__eyebrow {
    margin: 0 0 12px;
    color: #ffc037;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.02;

    @media (width >= 960px) {
      font-size: 64px;
    }
  }

  .hero__text {
    max-width: 420px;
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .hero__link {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    margin-top: 24px;
    padding: 14px 18px;
    border-radius: 4px;
    background: #ff641e;
    color: var(--color-white);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
</style>