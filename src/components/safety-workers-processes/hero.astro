---
import { getImage } from 'astro:assets';
import HeroBgDesktop from './assets/hero-bg-desktop.webp';
import HeroBgMobile from './assets/hero-bg-desktop.webp';
interface Props {
	title: string;
}

const { title } = Astro.props;
const [mobileBackground, desktopBackground] = await Promise.all([getImage({ src: HeroBgMobile }), getImage({ src: HeroBgDesktop })]);
---

<section class='hero'>
	<div class='hero__inner'>
		<h1 id='article-title'>{title}</h1>
		<p class='hero__text'>
			Начинаем серию статей, посвященных «Кодексу Удокана», нашим корпоративным ценностям и их воплощению в реальных рабочих процессах и ситуациях.
			Сегодня в фокусе — приоритет безопасности жизни и здоровья сотрудников.
		</p>
		<a class='hero__link' href='#values'>
			Разобраться на примерах <span>↓</span>
		</a>
	</div>
	<div class='hero__background'>
		<div class='hero__figure'>
			<svg width='1412' height='1632' viewBox='0 0 1412 1632' fill='none' xmlns='http://www.w3.org/2000/svg'>
				<path opacity='0.1' d='M1411.5 408.288V1223.71L706 1631.42L0.5 1223.71V408.288L706 0.576172L1411.5 408.288Z' stroke='#FDFAF9'></path>
				<path opacity='0.2' d='M1305.5 470.289V1161.71L706 1507.42L106.5 1161.71V470.289L706 124.577L1305.5 470.289Z' stroke='#FDFAF9'></path>
				<path opacity='0.3' d='M1211.5 524.789V1107.21L706 1398.42L200.5 1107.21V524.789L706 233.577L1211.5 524.789Z' stroke='#FDFAF9'></path>
				<path opacity='0.4' d='M1103.5 586.789V1045.21L706 1274.42L308.5 1045.21V586.789L706 357.577L1103.5 586.789Z' stroke='#FDFAF9'></path>
				<path opacity='0.5' d='M997.5 647.788V984.211L706 1152.42L414.5 984.211V647.788L706 479.576L997.5 647.788Z' stroke='#FDFAF9'></path>
				<path opacity='0.6' d='M888.5 710.789V921.21L706 1026.42L523.5 921.21V710.789L706 605.577L888.5 710.789Z' stroke='#FDFAF9'></path>
			</svg>
		</div>
		<div class='hero__image'>
			<picture>
				<source media='(min-width: 960px)' srcset={desktopBackground.src} type='image/webp' />
				<img src={mobileBackground.src} alt='' />
			</picture>
		</div>
	</div>
	<div class='hero__label'>
		<div class='hero__label__inner'> Безопасность начинается с каждого из нас </div>
	</div>
	<div class='hero__footer'>
		<svg width='1440' height='51' viewBox='0 0 1440 51' fill='none' xmlns='http://www.w3.org/2000/svg'>
			<path d='M720 51.1484H0V0L720 51.1484Z' fill='#FDFAF9'></path>
			<path d='M1440 51.1484H720L1440 0V51.1484Z' fill='#FDFAF9'></path>
		</svg>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		min-height: 850px;
		padding: 137px max(20px, calc((100% - 1240px) / 2)) 0;
		background:
			radial-gradient(87.53% 133.24% at 70% 20%, rgba(78, 139, 192, 0.42) 0%, rgba(78, 139, 192, 0) 32%),
			linear-gradient(107.03deg, #0b2034 8%, #17334e 50%, #285b86 100%);
		color: var(--color-white);

		@media (width >= 960px) {
			min-height: 850px;
		}
	}

	.hero__inner {
		position: relative;
		max-width: 556px;
		z-index: 10;
	}

	.hero__eyebrow {
		margin: 0 0 12px;
		color: var(--yellow-orange-accent);
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 70px;
		font-weight: 600;
		line-height: 1;
	}

	.hero__text {
		margin: 20px 0 0;
		font-size: 18px;
		line-height: 1.5;
	}

	.hero__link {
		margin-top: 40px;
		display: inline-flex;
		gap: 16px;
		align-items: center;
		padding: 0 24px;
		border-radius: 12px;
		height: 58px;
		background: #ff6b1a;
		color: var(--color-white);
		font-size: 15px;
		font-weight: bold;
		text-decoration: none;
		box-shadow: 0px 14px 34px rgba(255, 107, 26, 0.28);
		span {
			font-size: 20px;
		}
	}

	.hero__background {
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		overflow: hidden;
		pointer-events: none;
	}
	/* .hero__image::after {
		position: absolute;
		bottom: 0;
		left: 0;
		content: '';
		width: 100%;
		height: 251px;
		background: linear-gradient(180deg, #ffffff 0%, #12273b 100%);
		mix-blend-mode: multiply;
	} */
	.hero__figure {
		position: absolute;
		display: flex;
		top: 50%;
		left: 50%;
		transform: translate(0, calc(-50% + 36px));
		width: 1412px;
		svg {
			width: 100%;
			height: auto;
		}
	}
	.hero__image {
		position: absolute;
		display: flex;
		bottom: 0;
		left: 50%;
		transform: translate(calc(-50% + 302px), 50px);
		width: 870px;
		opacity: 0;
		transition:
			opacity 1s ease,
			transform 1s ease;
		picture,
		img {
			width: 100%;
			height: auto;
		}
		&.is-ready {
			opacity: 1;
			transform: translate(calc(-50% + 302px));
		}
		@media (prefers-reduced-motion: reduce) {
			opacity: 1;
			transform: translate(calc(-50% + 302px));
			transition: none;
		}
	}
	.hero__label {
		padding: 3px;
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translate(-50%, 50%);
		background: var(--brand-gradient-original);
		border-radius: 12px;
		box-shadow: 0px 24px 70px rgba(11, 32, 52, 0.14);
		z-index: 10;
	}

	.hero__label__inner {
		padding: 0 30px;
		background: var(--white-0);
		color: var(--black-100);
		font-weight: bold;
		line-height: 120%;
		font-size: 14px;
		border-radius: 10px;
		width: 270px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	.hero__footer {
		position: absolute;
		display: flex;
		bottom: -1px;
		left: 50%;
		transform: translate(-50%);
		width: 100%;
		max-width: 1440px;
		svg {
			width: 100%;
			height: auto;
		}
	}
	.hero__footer::after,
	.hero__footer::before {
		position: absolute;
		content: '';
		bottom: 0;
		background: var(--white-0);
		height: 100%;
		width: 50vw;
	}
	.hero__footer::after {
		right: calc(100% - 1px);
	}
	.hero__footer::before {
		left: calc(100% - 1px);
	}

	@media (width < 960px) {
		.hero {
			min-height: 882px;
			padding: 0;
			align-items: stretch;
			background: var(--black-100);
		}

		.hero__inner {
			box-sizing: border-box;
			width: 100%;
			max-width: 600px;
			padding: 116px 20px 0;
			z-index: 5;
		}

		h1 {
			max-width: 100%;
			font-size: 40px;
			font-weight: 600;
			line-height: 40px;
		}

		.hero__text {
			margin: 16px 0 0;
			font-size: 17px;
			line-height: 26px;
		}

		.hero__link {
			margin: 24px 0 0;
			gap: 4px;
			width: 233px;
			height: 44px;
			padding: 0 20px;
			border-radius: 4px;
			background: #ff6b1a;
			font-size: 14px;
			font-weight: 600;
			line-height: 20px;
			box-shadow: none;
			span {
				font-size: 14px;
			}
		}
		.hero__figure {
			top: 50%;
			right: -374.26px;
			left: auto;
			width: 749.26px;
			height: 866px;
			transform: translateY(calc(247px - 50%));
			opacity: 1;
		}

		.hero__image {
			position: absolute;
			left: 50%;
			width: 380px;
			height: 358px;
			transform: translate(calc(-50%), 50px);
			opacity: 1;
			picture,
			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
			}

			&.is-ready {
				transform: translate(calc(-50%));
			}
			@media (prefers-reduced-motion: reduce) {
				transform: translate(calc(-50%));
			}
		}

		.hero__label {
			display: none;
		}

		.hero__footer {
			bottom: -1px;
			width: 100%;
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const heroImage = document.querySelector('.hero__image img') as HTMLImageElement | null;
		const heroWrapper = document.querySelector('.hero__image') as HTMLElement | null;

		if (!heroImage || !heroWrapper) return;

		const revealImage = () => {
			requestAnimationFrame(() => {
				heroWrapper.classList.add('is-ready');
			});
		};

		const revealWhenReady = () => {
			if (heroImage.decode) {
				heroImage.decode().then(revealImage).catch(revealImage);
				return;
			}

			revealImage();
		};

		if (heroImage.complete && heroImage.naturalWidth > 0) {
			revealWhenReady();
			return;
		}

		heroImage.addEventListener('load', revealWhenReady, { once: true });
		heroImage.addEventListener('error', revealWhenReady, { once: true });
	});
</script>
