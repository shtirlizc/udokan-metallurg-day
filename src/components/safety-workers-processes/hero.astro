---
import { getImage } from 'astro:assets';
import HeroBgDesktop from './assets/hero-bg-desktop.webp';
import HeroBgMobile from './assets/hero-bg-desktop.webp';
interface Props {
	title: string;
}

const { title } = Astro.props;
const [mobileBackground, desktopBackground] = await Promise.all([getImage({ src: HeroBgMobile }), getImage({ src: HeroBgDesktop })]);
---

<section class='hero' aria-labelledby='article-title'>
	<div class='hero__inner'>
		<h1 id='article-title'>{title}</h1>
		<p class='hero__text'>
			Начинаем серию статей, посвященных «Кодексу Удокана», нашим корпоративным ценностям и их воплощению в реальных рабочих процессах и ситуациях.
			Сегодня в фокусе — приоритет безопасности жизни и здоровья сотрудников.
		</p>
		<a class='hero__link' href='#risk-scenarios'>
			Разобраться на примерах <span aria-hidden='true'>↓</span>
		</a>
	</div>
	<div class='hero__background'>
		<picture class='hero__image'>
			<source media='(min-width: 960px)' srcset={desktopBackground.src} type='image/webp' />
			<img src={mobileBackground.src} alt='' />
		</picture>
	</div>
	<div class='hero__label'>
		<div class='hero__label__inner'> Безопасность начинается с каждого из нас </div>
	</div>
	<div class='hero__footer'>
		<svg width='1440' height='51' viewBox='0 0 1440 51' fill='none' xmlns='http://www.w3.org/2000/svg'>
			<path d='M720 51.1484H0V0L720 51.1484Z' fill='#FDFAF9'></path>
			<path d='M1440 51.1484H720L1440 0V51.1484Z' fill='#FDFAF9'></path>
		</svg>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		min-height: 850px;
		padding: 137px max(20px, calc((100% - 1240px) / 2)) 0;
		background:
			radial-gradient(87.53% 133.24% at 70% 20%, rgba(78, 139, 192, 0.42) 0%, rgba(78, 139, 192, 0) 32%),
			linear-gradient(107.03deg, #0b2034 8%, #17334e 50%, #285b86 100%);
		color: var(--color-white);

		@media (width >= 960px) {
			min-height: 850px;
		}
	}

	.hero__inner {
		position: relative;
		max-width: 556px;
		z-index: 10;
	}

	.hero__eyebrow {
		margin: 0 0 12px;
		color:  var(--yellow-orange-accent);
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: 70px;
		font-weight: 600;
		line-height: 1;
	}

	.hero__text {
		margin: 20px 0 0;
		font-size: 18px;
		line-height: 1.5;
	}

	.hero__link {
		margin-top: 40px;
		display: inline-flex;
		gap: 16px;
		align-items: center;
		padding: 0 24px;
		border-radius: 12px;
    height: 58px;
		background: #ff6b1a;
		color: var(--color-white);
		font-size: 15px;
		font-weight: bold;
		text-decoration: none;
		box-shadow: 0px 14px 34px rgba(255, 107, 26, 0.28);
    span{
      font-size: 20px;
    }
	}

	.hero__background {
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		overflow: hidden;
		pointer-events: none;
	}
	.hero__image {
		position: absolute;
		display: flex;
		top: 50%;
		left: 50%;
		transform: translate(calc(-50% + 647px), calc(-50% - 174px));
		width: 1559px;
		picture,
		img {
			width: 100%;
			height: auto;
		}
	}
	.hero__label {
		padding: 3px;
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translate(-50%, 50%);
		background: var(--brand-gradient-original);
		border-radius: 12px;
		box-shadow: 0px 24px 70px rgba(11, 32, 52, 0.14);
		z-index: 10;
	}

	.hero__label__inner {
		padding: 0 30px;
		background: var(--white-0);
		color: var(--black-100);
		font-weight: bold;
		line-height: 120%;
		font-size: 14px;
		border-radius: 10px;
		width: 270px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	.hero__footer {
		position: absolute;
		display: flex;
		bottom: -1px;
		left: 50%;
		transform: translate(-50%);
		width: 100%;
		max-width: 1440px;
		svg {
			width: 100%;
			height: auto;
		}
	}
	.hero__footer::after,
	.hero__footer::before {
		position: absolute;
		content: '';
		bottom: 0;
		background: var(--white-0);
		height: 100%;
		width: calc((100vw - 1438px) / 2);
	}
	.hero__footer::after {
		right: calc(100% - 1px);
	}
	.hero__footer::before {
		left: calc(100% - 1px);
	}
</style>
