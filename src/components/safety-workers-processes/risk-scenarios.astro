---
import RiskScenarioItem from './risk-scenario-item.astro';

import RiskComicsImg0Desktop from './assets/risk-comics-img-0.webp';
import RiskComicsImg0Mobile from './assets/risk-comics-img-0-mobile.webp';
import RiskComicsImg1Desktop from './assets/risk-comics-img-1.webp';
import RiskComicsImg1Mobile from './assets/risk-comics-img-1-mobile.webp';
import RiskComicsImg2Desktop from './assets/risk-comics-img-2.webp';
import RiskComicsImg2Mobile from './assets/risk-comics-img-2-mobile.webp';
import RiskComicsImg3Desktop from './assets/risk-comics-img-3.webp';
import RiskComicsImg3Mobile from './assets/risk-comics-img-3-mobile.webp';
import RiskComicsImg4Desktop from './assets/risk-comics-img-4.webp';
import RiskComicsImg4Mobile from './assets/risk-comics-img-4-mobile.webp';

const scenariosData = [
	{
		title: 'Ремень в вахтовом автобусе',
		text: 'В вахтовом автобусе едет сотрудник, не пристегнутый ремнем безопасности. Это чревато травмой при резком торможении.',
		image: {
			mobile: RiskComicsImg0Mobile,
			desktop: RiskComicsImg0Desktop,
		},
		// the speech bubble is part of the picture
		quote: '«Фиксатор сломан? И так доеду!»',
	},
	{
		title: 'Без СИЗ на производстве',
		text: 'Сотрудник находится на производственной площадке без каски. Пренебрежение обязательным СИЗом в опасной зоне может привести к травме.',
		image: {
			mobile: RiskComicsImg1Mobile,
			desktop: RiskComicsImg1Desktop,
		},
		// the speech bubble is part of the picture
		quote: '«Каску в столовой забыл, ну да ладно, позже заберу»',
	},
	{
		title: 'Сломанное ограждение',
		text: 'Сотрудник проходит мимо конвейера со сломанным ограждением и не сообщает о повреждении — возникает риск травмироваться движущимися или вращающимися частями оборудования.',
		image: {
			mobile: RiskComicsImg2Mobile,
			desktop: RiskComicsImg2Desktop,
		},
		// the speech bubble is part of the picture
		quote: '«Это не моя зона ответственности»',
	},
	{
		title: 'Работа на высоте',
		text: 'Сотрудник поднимается на высоту без страховочной привязи. Неиспользование страховочной системы создает риск падения и травмы.',
		image: {
			mobile: RiskComicsImg3Mobile,
			desktop: RiskComicsImg3Desktop,
		},
		// the speech bubble is part of the picture
		quote: '«Да я на 1 минуту, дольше буду надевать страховочную привязь»',
	},
	{
		text: 'Перечисленные действия могут на первый взгляд показаться незначительными. Но они запускают цепочку событий, которые приводят к возникновению риска, а в худшем случае — к травмам. Наша цель — научиться своевременно замечать и предотвращать такие риски и выстроить действительно безопасное производство.',
		attention: true,
		image: {
			mobile: RiskComicsImg4Mobile,
			desktop: RiskComicsImg4Desktop,
		},
	},
];
---

<section class='scenarios' id='risk-scenarios'>
	<div class='scenarios__intro'>
		<h2 class='scenarios__title'>Как риск начинается с фразы «ничего страшного»</h2>
		<div class='scenarios__text'>Посмотрим, как «Кодекс Удокана» отражается в реальных примерах из жизни сотрудников компании.</div>
	</div>
	<div class='scenarios__list'>
		{scenariosData.map((scenario, index) => <RiskScenarioItem index={index} {...scenario} />)}
	</div>
	<div class='scenarios__decor'>
		<svg width='1440' height='51' viewBox='0 0 1440 51' fill='none' xmlns='http://www.w3.org/2000/svg'>
			<path d='M720 51.1484H0V0L720 51.1484Z' fill='#C8D2DC'></path>
			<path d='M1440 51.1484H720L1440 0V51.1484Z' fill='#C8D2DC'></path>
		</svg>
	</div>
</section>

<style>
	.scenarios {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 181px 0 0;
		background: var(--white-0);
	}
	.scenarios__intro {
		max-width: 780px;
	}

	.scenarios__title {
		margin: 0;
		font-size: 56px;
		font-weight: 600;
		line-height: 1;
	}

	.scenarios__text {
		margin-top: 20px;
		line-height: 140%;
	}

	.scenarios__list {
		margin: 40px auto 0;
		position: relative;
		width: 100%;
		height: 123.375em;
		max-width: 1440px;
		font-size: min(16px, 1.111111vw);
	}

	.scenarios__decor {
		position: absolute;
		display: flex;
		bottom: -1px;
		left: 50%;
		transform: translate(-50%);
		width: 100%;
		max-width: 1440px;
		z-index: 10;
		svg {
			width: 100%;
			height: auto;
		}
	}
	.scenarios__decor::after,
	.scenarios__decor::before {
		position: absolute;
		content: '';
		bottom: 0;
		background: #c8d2dc;
		height: 100%;
		width: 50vw;
	}
	.scenarios__decor::after {
		right: calc(100% - 1px);
	}
	.scenarios__decor::before {
		left: calc(100% - 1px);
	}

	@media (width < 960px) {
		.scenarios {
			padding: 80px 0 35px;
		}
		.scenarios__intro {
			padding: 0 20px;
		}

		.scenarios__title {
			font-size: 34px;
			line-height: 36px;
		}

		.scenarios__text {
			margin-top: 16px;
			font-size: 17px;
			line-height: 26px;
		}

		.scenarios__list {
			margin: 40px auto 0;
			height: auto;
			font-size: 14px;
		}
		.scenarios__decor {
			display: none;
		}
	}
</style>
