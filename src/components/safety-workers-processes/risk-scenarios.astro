---
const scenarios = [1, 2, 3, 4, 5];
---

<section class="scenarios" id="risk-scenarios" aria-labelledby="scenarios-title">
  <div class="scenarios__intro">
    <h2 id="scenarios-title">Как риск начинается с фразы «ничего страшного»</h2>
    <p>Посмотрим, как решения влияют на безопасность в рабочих ситуациях.</p>
  </div>
  <ol class="scenarios__list">
    {scenarios.map((scenario) => (
      <li>
        <div class="scenarios__image" aria-hidden="true"></div>
        <div class="scenarios__caption">
          <h3>Ситуация {String(scenario).padStart(2, "0")}</h3>
          <p>Описание ситуации и правильного действия будет добавлено.</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="scenarios__briefing" aria-hidden="true"></div>
</section>

<style>
  .scenarios {
    padding: 72px 20px;
    background: var(--white-0);
  }

  .scenarios__intro,
  .scenarios__list,
  .scenarios__briefing {
    width: min(100%, 1040px);
    margin-inline: auto;
  }

  h2 {
    max-width: 560px;
    margin: 0;
    font-size: 32px;
    font-weight: 600;
    line-height: 1.08;
  }

  .scenarios__intro p,
  .scenarios__caption p {
    font-size: 14px;
    line-height: 1.45;
  }

  .scenarios__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
    padding: 0;
    list-style: none;

    li {
      min-width: 0;
      border: 1px solid #d3d9df;
    }

    li:last-child {
      grid-column: 1 / -1;
    }
  }

  .scenarios__image {
    aspect-ratio: 1.45;
    background: #cbd6de;
  }

  .scenarios__caption {
    padding: 12px;

    h3 {
      margin: 0;
      font-size: 15px;
    }

    p {
      margin: 8px 0 0;
    }
  }

  .scenarios__briefing {
    min-height: 220px;
    margin-top: 20px;
    background: #cbd6de;
  }

  @media (width >= 760px) {
    .scenarios__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));

      li:last-child {
        grid-column: auto;
      }
    }
  }
</style>