---
import { getImage } from 'astro:assets';
import TeamSupportPeopleDesktop from './assets/team-support-people.webp';
import TeamSupportPerson0 from './assets/team-support-person-0.webp';
import TeamSupportPerson1 from './assets/team-support-person-1.webp';
import TeamSupportPerson2 from './assets/team-support-person-2.webp';
const responsibilities = [
	'Обучают основам безопасного поведения на производстве',
	'Обучают и контролируют правильность применения СИЗ',
	'Проверяют условия труда и выявляют потенциально опасные ситуации',
	'Помогают коллегам правильно оформлять отказ от работы в небезопасных условиях',
];

// on mobile the strip becomes a stack of panels; the quotes are part of these images
const personImages = [TeamSupportPerson0, TeamSupportPerson1, TeamSupportPerson2];
const widest = Math.max(...personImages.map((image) => image.width));
const people = await Promise.all(
	personImages.map(async (image) => ({
		width: image.width,
		height: image.height,
		share: `${((image.width / widest) * 100).toFixed(2)}%`,
		img: await getImage({ src: image, widths: [400, 750, 1137], quality: 78 }),
	})),
);
const desktopBackground = await getImage({ src: TeamSupportPeopleDesktop, widths: [1440, 2160, 2880], quality: 78 });
---

<section class='team-support'>
	<div class='team-support__decor team-support__decor_top'>
		<svg width='1440' height='52' viewBox='0 0 1440 52' fill='none' xmlns='http://www.w3.org/2000/svg'>
			<path d='M720 0H0V51.1484L720 0Z' fill='#F8FAFD'></path>
			<path d='M1440 0H720L1440 51.1484V0Z' fill='#F8FAFD'></path>
		</svg>
	</div>
	<div class='team-support__inner'>
		<div class='team-support__intro'>
			<h2 class='team-support__title'>Кто помогает создавать безопасную среду</h2>
			<p class='team-support__text'>
				Формировать культуру безопасного производства и нулевого травматизма на Удокане помогают сотрудники Департамента охраны труда, промышленной
				безопасности и охраны окружающей среды (ДОТПБиООС). Они действуют в рамках корпоративного стандарта и всегда рады помочь коллегам.</p
			>
		</div>
	</div>

	<div class='team-support__tasks'>
		<div class='team-support__people'>
			<img
				class='team-support__image'
				src={desktopBackground.src}
				srcset={desktopBackground.srcSet.attribute}
				sizes='100vw'
				width={TeamSupportPeopleDesktop.width}
				height={TeamSupportPeopleDesktop.height}
				alt=''
				loading='lazy'
			/>
			<ul class='team-support__stack'>
				{
					people.map((person) => (
						<li class='team-support__person' style={`--share: ${person.share}`}>
							<img
								src={person.img.src}
								srcset={person.img.srcSet.attribute}
								sizes='(width < 600px) 100vw, 560px'
								width={person.width}
								height={person.height}
								alt=''
								loading='lazy'
							/>
						</li>
					))
				}
			</ul>
		</div>
		<div class='team-support__inner'>
			<h3>Задачи команды ДОТПБиООС</h3>
			<ul>
				{
					responsibilities.map((item) => (
						<li>
							<span class='team-support__icon'>
								<svg width='22' height='22' viewBox='0 0 22 22' fill='none' xmlns='http://www.w3.org/2000/svg'>
									<rect width='22' height='22' rx='11' fill='#FFC037' />
									<path
										d='M9.56291 14.4883L5.56451 10.1539L6.76291 8.97791L9.52931 11.9459L15.5213 5.05791L16.7869 6.18911L9.56291 14.4883Z'
										fill='#19324B'
									/>
								</svg>
							</span>
							{item}
						</li>
					))
				}
			</ul>
		</div>
	</div>
	<div class='team-support__decor team-support__decor_bottom'>
		<svg width='1440' height='51' viewBox='0 0 1440 51' fill='none' xmlns='http://www.w3.org/2000/svg'>
			<path d='M720 51.1484H0V0L720 51.1484Z' fill='#F8FAFD'></path>
			<path d='M1440 51.1484H720L1440 0V51.1484Z' fill='#F8FAFD'></path>
		</svg>
	</div>
</section>

<style>
	.team-support {
		position: relative;
		padding: 180px 0px 0;
		background: var(--black-100);
		color: var(--color-white);
	}

	.team-support__inner {
		margin: 0 auto;
		max-width: 780px;
		width: 100%;
	}

	.team-support__title {
		margin: 0;
		font-size: 56px;
		font-weight: 600;
		line-height: 1;
	}

	.team-support__text {
		margin-top: 30px;
		line-height: 140%;
	}

	.team-support__people {
		margin-bottom: 94px;
		display: flex;
		width: 100%;
	}
	.team-support__image {
		margin-top: -13.889vw;
		display: block;
		width: 100%;
		height: auto;
	}
	.team-support__stack {
		display: none;
	}
	.team-support__tasks {
		margin-top: 19.306vw;
		padding: 0 0 150px;
		background: #c8d2dc;
		color: var(--black-100);

		h3 {
			margin: 0 0 17px;
			font-size: 27.5px;
			letter-spacing: -0.56px;
		}

		ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}

		li {
			display: flex;

			align-items: center;
			padding: 14px 0;
			font-size: 17px;
			line-height: 26px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.16);
		}
	}
	.team-support__icon {
		margin-top: 2px;
		display: flex;
		margin-right: 14px;
		width: 22px;
		height: 22px;
	}
	.team-support__decor {
		position: absolute;
		display: flex;
		left: 50%;
		transform: translate(-50%);
		width: 100%;
		max-width: 1440px;
		svg {
			width: 100%;
			height: auto;
		}
	}
	.team-support__decor_top {
		top: -1px;
	}
	.team-support__decor_bottom {
		bottom: -1px;
	}
	.team-support__decor::after,
	.team-support__decor::before {
		position: absolute;
		content: '';
		bottom: 0;
		height: 100%;
		background: #f8fafd;
		width: 50vw;
	}
	.team-support__decor::after {
		right: calc(100% - 1px);
	}
	.team-support__decor::before {
		left: calc(100% - 1px);
	}

	@media (width < 960px) {
		.team-support {
			padding: 80px 0px 0;
		}

		.team-support__inner {
			margin: 0 auto;
			padding: 0 20px;
		}

		.team-support__title {
			margin: 0;
			font-size: 34px;
			line-height: 36px;
		}

		.team-support__text {
			margin-top: 16px;
			font-size: 17px;
			line-height: 26px;
		}

		/* panels stacked one under another, quotes are part of the images */
		.team-support__people {
			margin: 0;
			padding: 32px 0 0;
			background: linear-gradient(to bottom, var(--black-100) calc(100% - 120px), #c8d2dc calc(100% - 120px));
		}
		.team-support__image {
			display: none;
		}
		.team-support__stack {
			display: flex;
			flex-direction: column;
			gap: 16px;
			width: 100%;
			max-width: 560px;
			margin: 0 auto;
			padding: 0;
			list-style: none;
		}
		/* doubled class beats the generic `.team-support__tasks li` rules */
		.team-support__stack .team-support__person {
			display: block;
			width: var(--share, 100%);
			padding: 0;
			border: 0;
			img {
				display: block;
				width: 100%;
				height: auto;
			}
			&:nth-child(2) {
				align-self: flex-end;
			}
		}
		.team-support__tasks {
			margin-top: 40px;
			padding: 0 0 73px;

			h3 {
				margin: 0 0 12px;
				font-size: 24px;
				line-height: 120%;
				letter-spacing: 0;
			}
			li {
				align-items: flex-start;
				padding: 10px 0;
				font-size: 16px;
				line-height: 120%;
				border-bottom: none;
			}
		}
		.team-support__icon {
			margin-top: 0;
			margin-right: 12px;
		}
	}
</style>
