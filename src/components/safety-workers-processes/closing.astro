---
import { getImage } from 'astro:assets';
import ClosingDesktop from './assets/closing-desktop.webp';
import ClosingMobile from './assets/closing-mobile.webp';
import Pattern from './assets/principles-pattern.webp';
const [mobileBackground, desktopBackground, patternImg] = await Promise.all([
	getImage({ src: ClosingMobile }),
	getImage({ src: ClosingDesktop }),
	getImage({ src: Pattern }),
]);
---

<section class='closing' style={`--principles-pattern: url(${patternImg.src})`}>
	<h2 class='closing__title'> Безопасность — это не свод запретов, а ответственность и внимательность каждого из нас </h2>
	<picture class='closing__image'>
		<source media='(min-width: 960px)' srcset={desktopBackground.src} type='image/webp' />
		<img src={mobileBackground.src} alt='' />
	</picture>
</section>

<style>
	.closing {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 68px 0 0;
		padding: 68px 0 0;
		color: var(--color-white);
		text-align: center;
		width: 100%;
		background-color: var(--black-100);
		background-image: var(--principles-pattern);
		background-size: 116px 77px;
		overflow: hidden;
	}

	.closing::before {
		position: absolute;
		display: flex;
		content: '';
		width: 2670px;
		height: 1148px;
		left: 50%;
		bottom: -802px;
		transform: translateX(-50%);
		background: #102030;
		filter: blur(375px);
	}
	.closing__title {
		position: relative;
		z-index: 1;
		max-width: 1148px;
		margin: 0;
		text-align: center;
		font-size: 70px;
		font-weight: 600;
		line-height: 1;
	}
	.closing__image {
		position: relative;
		margin-top: -12px;
		display: flex;
		width: 100%;
		height: auto;
		z-index: 10;
		img {
			width: 100%;
			height: auto;
		}
	}
</style>
