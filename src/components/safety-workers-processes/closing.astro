---
import { getImage } from 'astro:assets';
import ClosingDesktop from './assets/closing-desktop.webp';
import ClosingMobile from './assets/closing-mobile.webp';
import Pattern from './assets/principles-pattern.webp';
const [mobileBackground, desktopBackground, patternImg] = await Promise.all([
	getImage({ src: ClosingMobile, widths: [750, 1125, 1500], quality: 78 }),
	getImage({ src: ClosingDesktop, widths: [1440, 2160, 2880], quality: 78 }),
	getImage({ src: Pattern }),
]);
---

<section class='closing' style={`--principles-pattern: url(${patternImg.src})`}>
	<h2 class='closing__title'> Безопасность — это не свод запретов, а ответственность и внимательность каждого из нас </h2>
	<picture class='closing__image'>
		<source
			media='(min-width: 960px)'
			srcset={desktopBackground.srcSet.attribute}
			sizes='100vw'
			width={ClosingDesktop.width}
			height={ClosingDesktop.height}
			type='image/webp'
		/>
		<img
			src={mobileBackground.src}
			srcset={mobileBackground.srcSet.attribute}
			sizes='100vw'
			width={ClosingMobile.width}
			height={ClosingMobile.height}
			alt=''
			loading='lazy'
		/>
	</picture>
</section>

<style>
	.closing {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 68px 0 0;
		color: var(--color-white);
		text-align: center;
		width: 100%;
		background-color: var(--black-100);
		background-image: var(--principles-pattern);
		background-size: 116px 77px;
		overflow: hidden;
	}

	.closing::before {
		position: absolute;
		display: flex;
		content: '';
		width: 2670px;
		height: 1148px;
		left: 50%;
		bottom: -802px;
		transform: translateX(-50%);
		background: #102030;
		filter: blur(375px);
	}
	.closing__title {
		position: relative;
		z-index: 1;
		max-width: 1148px;
		margin: 0;
		text-align: center;
		font-size: 70px;
		font-weight: 600;
		line-height: 1;
	}
	.closing__image {
		position: relative;
		margin-top: -103px;
		display: flex;
		width: 100%;
		height: auto;
		z-index: 10;
		img {
			width: 100%;
			height: auto;
		}
	}
	@media (width < 960px) {
		.closing {
			padding: 80px 0 0;
		}

		.closing::before {
			display: none;
		}
		.closing__title {
			padding: 0 20px;
			max-width: 780px;
			font-size: 34px;
			line-height: 36px;
		}
		.closing__image {
			margin-top: -16px;
		}
	}
</style>
