---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	index: number;
	title?: string;
	attention?: boolean;
	text: string;
	image?: {
		mobile: ImageMetadata;
		desktop: ImageMetadata;
	};
	/** Speech bubble drawn on the picture, repeated for screen readers. */
	quote?: string;
}

const { title, text, image, index, quote, attention } = Astro.props;
const mobileBackground = image ? await getImage({ src: image.mobile, widths: [750, 1125, 1500, 1800], quality: 78 }) : undefined;
const desktopBackground = image
	? await getImage({ src: image.desktop, widths: [image.desktop.width / 2, image.desktop.width], quality: 78 })
	: undefined;
// panels are laid out in em on a 1440px canvas, desktop art is exported at 2x
const desktopCssWidth = image ? image.desktop.width / 2 : 0;
const desktopSizes = `(width < 1440px) ${((desktopCssWidth / 1440) * 100).toFixed(1)}vw, ${desktopCssWidth}px`;
---

<div class:list={['scenario-item', `scenario-item_${index}`]}>
	<div class='scenario-item__visual'>
		{
			image && mobileBackground && desktopBackground && (
				<picture class='scenario-item__image'>
					<source
						media='(min-width: 960px)'
						srcset={desktopBackground.srcSet.attribute}
						sizes={desktopSizes}
						width={image.desktop.width}
						height={image.desktop.height}
						type='image/webp'
					/>
					<img
						src={mobileBackground.src}
						srcset={mobileBackground.srcSet.attribute}
						sizes='100vw'
						width={image.mobile.width}
						height={image.mobile.height}
						alt={quote ?? ''}
						loading='lazy'
					/>
				</picture>
			)
		}
	</div>
	<div class='scenario-item__caption'>
		{
			attention && (
				<div class='scenario-item__icon'>
					<span>!</span>
				</div>
			)
		}
		{title && <h3>{title}</h3>}
		<p>{text}</p>
	</div>
</div>

<style>
	.scenario-item {
		position: absolute;
		display: flex;
		font-size: 1em;
	}
	.scenario-item_0 {
		top: 0;
		left: 0.125em;
		width: 45em;
		height: 48.125em;
		.scenario-item__caption {
			left: 0.1875em;
			bottom: 2.25em;
			max-width: 20.625em;
		}
	}
	.scenario-item_1 {
		top: 0;
		right: 0;
		width: 48.125em;
		height: 48.125em;
		.scenario-item__caption {
			right: 0.25em;
			bottom: 3.125em;
			max-width: 21.8125em;
		}
	}
	.scenario-item_2 {
		top: 45em;
		left: 0;
		width: 51.25em;
		height: 45em;
		z-index: 4;

		.scenario-item__caption {
			left: 0;
			bottom: 0.25em;
			max-width: 25.375em;
		}
	}
	.scenario-item_3 {
		top: 45em;
		right: 0;
		width: 45em;
		height: 48.0625em;
		z-index: 5;
		/* flush with the bottom of the picture, left side follows its slanted edge */
		.scenario-item__caption {
			left: 0;
			bottom: 3.36em;
			max-width: 25em;

			@media (width >= 960px) {
				padding-left: 2.5em;
				clip-path: polygon(2em 0, 100% 0, 100% 100%, 0.7em 100%);
			}
		}
	}
	.scenario-item_4 {
		bottom: 0;
		left: 0;
		width: 100%;
		z-index: 3;
		.scenario-item__caption {
			padding: 1.5em 1.5em 3.5em;
			display: flex;
			right: 0;
			bottom: 4.125em;
			background: #f9fafe;
			max-width: 31.6em;
			p {
				line-height: 140%;
			}
		}
	}
	/* the caption continues the slanted cut-out of the picture down to its bottom edge */
	@media (width >= 960px) {
		.scenario-item_4 .scenario-item__caption {
			top: 60%;
			left: 64.5%;
			bottom: 0;
			max-width: none;
			padding: 4.5em 3em 1.5em 1.5em;
			background: #f9fbfc;
			clip-path: polygon(0 10.5%, 100% 0, 100% 100%, 1.2% 100%);
		}
	}
	.scenario-item__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 1.125em;
		width: 2.75em;
		height: 2.75em;
		border-radius: 50%;
		font-weight: bold;
		color: var(--color-white);
		background: #ff6b1a;
		flex-shrink: 0;
		span {
			font-size: 1.25em;
		}
	}
	.scenario-item__visual {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.scenario-item__image {
		display: flex;
		width: 100%;
		picture,
		img {
			width: 100%;
			height: auto;
		}
	}


	.scenario-item__caption {
		position: absolute;
		padding: 1.5em;
		background: var(--color-white);
		z-index: 1;
		h3 {
			margin: 0 0 0.5em;
			font-size: 1em;
		}

		p {
			margin: 0;
			font-size: 0.875em;
			line-height: 120%;
		}
	}

	@media (width < 960px) {
		.scenario-item {
			position: relative;
			display: flex;
			flex-direction: column;
			top: 0;
			left: 0;
			right: unset;
			bottom: unset;
			font-size: 16px;
			width: 100%;
			height: auto;
			.scenario-item__caption {
				padding: 12px 20px;
				top: 0;
				left: 0;
				right: unset;
				bottom: unset;
				max-width: 100%;
				position: relative;
			}
		}
		.scenario-item__caption {
			max-width: 100%;
			position: relative;
		}
		.scenario-item_4{
			.scenario-item__caption{
				padding: 20px;
			}
		}
		.scenario-item__icon {
			display: flex;
			margin-right: 8px;
			width: 26px;
			height: 26px;
			span {
				font-size: 21px;
			}
		}
		.scenario-item__visual {
			height: auto;
		}


		.scenario-item__caption {
			h3 {
				margin: 0 0 8px;
				font-size: 16px;
				line-height: 120%;
			}

			p {
				margin: 0;
				font-size: 14px;
				line-height: 20px;
			}
		}
	}
</style>
