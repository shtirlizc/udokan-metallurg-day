				transform: rotate(5.66deg);
			}
		}
		.scenario-item_1 {
			.scenario-item__hint {
				top: 26.6%;
				left: 38.3%;
			}
			.scenario-item__hint__body {
				top: -70px;
				left: -30px;
				width: 149px;
				height: 50px;
				transform: rotate(-6.1deg);
			}
		}
		.scenario-item_2 {
			.scenario-item__hint {
				top: 61.5%;
				left: 25%;
			}
			.scenario-item__hint__body {
				padding: 10px 12px 10px 21px;
				top: 3px;
				left: 26px;
				width: 144px;
				height: 50px;
				transform: rotate(8.84deg);
			}
		}
		.scenario-item_3 {
			.scenario-item__hint {
				top: 32%;
				left: 48%;
			}
			.scenario-item__hint__body {
				padding: 16px 12px 10px 11px;
				top: 43px;
				left: -20px;
				width: 149px;
				height: 59px;
				transform: rotate(15.89deg);
			}
		}
		.scenario-item_4{
			.scenario-item__caption{
				padding: 20px;
			}
		}
		.scenario-item__icon {
			display: flex;
			margin-right: 8px;
			width: 26px;
			height: 26px;
			span {
				font-size: 21px;
			}
		}
		.scenario-item__visual {
			height: auto;
		}

		.scenario-item__hint__icon {
			width: 22px;
			height: 22px;
		}
		.scenario-item__hint__body {
			padding: 10px 12px;
		}
		.scenario-item__hint__bubble {
			position: absolute;
			inset: 0;
			z-index: 0;
			width: 100%;
			height: 100%;
			img {
				width: 100%;
				height: auto;
			}
		}
		.scenario-item__hint__body p {
			position: relative;
			z-index: 1;
		}
		.scenario-item__hint {
			font-weight: 600;
			font-size: 12px;
			line-height: 12px;
		}

		.scenario-item__caption {
			h3 {
				margin: 0 0 8px;
				font-size: 16px;
				line-height: 120%;
			}

			p {
				margin: 0;
				font-size: 14px;
				line-height: 20px;
			}
		}
	}
</style>
