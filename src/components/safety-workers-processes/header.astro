---
import Logo from "../logo.astro";
---

<header class="article-header">
  <div class="article-header__logo">
    <Logo />
  </div>
  <nav aria-label="Навигация по статье">
    <a href="#values">Приоритет</a>
    <a href="#practices">На практике</a>
    <a href="#road-safety">На дороге</a>
    <a href="#commitments">Чек-лист</a>
  </nav>
</header>

<style>
  .article-header {
    min-height: 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 8px max(20px, calc((100% - 1120px) / 2));
    background: var(--white-0);

    nav {
      display: flex;
      gap: clamp(12px, 3vw, 36px);
      overflow-x: auto;
      font-size: 12px;
      white-space: nowrap;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    @media (width < 600px) {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }

  .article-header__logo :global(.logo svg) {
    width: 116px;
    height: auto;
  }
</style>