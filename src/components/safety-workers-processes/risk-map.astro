---
import { getImage } from 'astro:assets';
import RiskMapDesktop from './assets/risk-map-desktop.webp';
import RiskMapMobile from './assets/risk-map-mobile.webp';
const riskPoints = [
	{
		title: 'Человек в зоне действия экскаватора.',
		text: 'Например, водитель выходит из кабины, кто-то подходит убрать просыпь или что-то проверить. Опасен не только ковш, но и задняя часть поворотной платформы с противовесом. При повороте машинист её не видит, и она может прижать человека к самосвалу. Во время погрузки водитель сидит в кабине под козырьком.',
	},
	{
		title: 'Ковш проносят над кабиной самосвала.',
		text: 'Грузить положено только сбоку или сзади кузова. Если ковш идёт над кабиной, то при открытии днища раньше времени или срыве крупного куска породы удар приходится прямо на кабину. Защитный козырёк кузова выдерживает отдельные мелкие куски, а содержимое ковша (десятки тонн) он не держит.',
	},
	{
		title: 'Перегруз, неравномерная загрузка и разгрузка с высоты.',
		text: 'Порода выше бортов падает на дорогу и на встречные машины на съездах. Смещённый на одну сторону груз меняет центр тяжести и повышает риск опрокидывания на уклонах и поворотах. Если высыпать породу с большой высоты или бросить в кузов негабарит, удар придётся на раму и подвеску и передастся водителю в кабину.',
	},
	{
		title: 'Самосвал заезжает под погрузку без сигнала машиниста или не стоит на тормозе. ',
		text: 'Самосвал ждёт за пределами радиуса действия экскаватора и въезжает только по сигналу. Если он заедет, пока платформа поворачивается, его ударит ковш или противовес. Если он откатится во время погрузки, ковш промахнётся и порода упадёт мимо кузова.',
	},
	{
		title: 'Наезд на силовой кабель экскаватора.',
		text: 'Экскаватор электрический: сзади виден кабельный барабан, питание идёт по высоковольтному кабелю. Переезжать кабель можно только по специальным кабельным переездам. Колесо гружёного самосвала продавливает изоляцию, что грозит пробоем, напряжением на корпусе или грунте, поражением током и пожаром.',
	},
];

const [mobileBackground, desktopBackground] = await Promise.all([
	getImage({ src: RiskMapMobile, widths: [750, 1125, 1500], quality: 78 }),
	getImage({ src: RiskMapDesktop, widths: [1440, 2160, 2880], quality: 78 }),
]);
---

<section class='risk-map'>
	<div class='risk-map__inner'>
		<aside class='risk-map__aside'>
			<h2 class='risk-map__title'>Что не так с безопасностью на промплощадке?</h2>
			<p class='risk-map__text'>Внимательно посмотрите на иллюстрацию и объясните все потенциально опасные ситуации. Нажмите на ситуацию, чтобы проверить себя.</p>
			<div class='risk-map__details' aria-live='polite'>
				<p class='risk-map__placeholder' data-risk-placeholder>Нажмите на красную точку на иллюстрации — здесь появится описание опасной ситуации.</p>
				<h3 data-risk-display-title></h3>
				<p data-risk-display-text></p>
			</div>
		</aside>
		<div class='risk-map__scene'>
			<div class='risk-map__img'>
				<picture class='risk-map__image'>
					<source
						media='(min-width: 960px)'
						srcset={desktopBackground.srcSet.attribute}
						sizes='min(100vw, 1440px, calc((100vh - 69px) * 16 / 9))'
						width={RiskMapDesktop.width}
						height={RiskMapDesktop.height}
						type='image/webp'
					/>
					<img
						src={mobileBackground.src}
						srcset={mobileBackground.srcSet.attribute}
						sizes='100vw'
						width={RiskMapMobile.width}
						height={RiskMapMobile.height}
						alt=''
						loading='lazy'
					/>
				</picture>
			</div>

			<div class='risk-map__points'>
				{
					riskPoints.map((point, index) => (
						<button
							class='risk-map__point'
							type='button'
							aria-label={`Опасная ситуация ${index + 1}`}
							aria-pressed='false'
							data-title={point.title}
							data-text={point.text}
						/>
					))
				}
			</div>
			<div class='risk-map__bubble' data-risk-bubble hidden>
				<button class='risk-map__bubble-close' type='button' aria-label='Закрыть' data-risk-bubble-close>×</button>
				<h3 data-risk-bubble-title></h3>
				<p data-risk-bubble-text></p>
			</div>
		</div>
	</div>
</section>

<script>
	const map = document.querySelector<HTMLElement>('.risk-map');
	if (map) {
		const title = map.querySelector<HTMLElement>('[data-risk-display-title]');
		const text = map.querySelector<HTMLElement>('[data-risk-display-text]');
		const placeholder = map.querySelector<HTMLElement>('[data-risk-placeholder]');
		const scene = map.querySelector<HTMLElement>('.risk-map__scene');
		const bubble = map.querySelector<HTMLElement>('[data-risk-bubble]');
		const bubbleTitle = map.querySelector<HTMLElement>('[data-risk-bubble-title]');
		const bubbleText = map.querySelector<HTMLElement>('[data-risk-bubble-text]');
		const points = map.querySelectorAll<HTMLButtonElement>('.risk-map__point');
		const mobile = window.matchMedia('(width < 960px)');

		const setActive = (active: HTMLButtonElement | null) => {
			points.forEach((item) => {
				const isActive = item === active;
				item.classList.toggle('risk-map__point--active', isActive);
				item.setAttribute('aria-pressed', String(isActive));
			});
		};

		const closeBubble = () => {
			if (!bubble) return;
			bubble.hidden = true;
			setActive(null);
		};

		// on mobile the description appears next to the point, like the characters' speech bubbles
		const openBubble = (point: HTMLButtonElement) => {
			if (!bubble || !scene || !bubbleTitle || !bubbleText) return;
			bubbleTitle.textContent = point.dataset.title ?? '';
			bubbleText.textContent = point.dataset.text ?? '';
			bubble.hidden = false;
			const sceneRect = scene.getBoundingClientRect();
			const pointRect = point.getBoundingClientRect();
			const x = pointRect.left + pointRect.width / 2 - sceneRect.left;
			const y = pointRect.top + pointRect.height / 2 - sceneRect.top;
			const below = y < sceneRect.height / 2;
			bubble.classList.toggle('risk-map__bubble--below', below);
			bubble.style.top = below ? `${y + 26}px` : '';
			bubble.style.bottom = below ? '' : `${sceneRect.height - y + 26}px`;
			bubble.style.setProperty('--tail-x', `${x - bubble.offsetLeft}px`);
		};

		points.forEach((point) => {
			point.addEventListener('click', (event) => {
				event.stopPropagation();
				setActive(point);
				if (title && text && placeholder) {
					placeholder.hidden = true;
					title.textContent = point.dataset.title ?? '';
					text.textContent = point.dataset.text ?? '';
				}
				if (mobile.matches) openBubble(point);
			});
		});

		map.querySelector('[data-risk-bubble-close]')?.addEventListener('click', closeBubble);
		document.addEventListener('click', () => bubble && !bubble.hidden && closeBubble());
		mobile.addEventListener('change', () => bubble && (bubble.hidden = true));
	}
</script>

<style>
	.risk-map {
		position: relative;
		display: flex;
		justify-content: center;
		background: #e5ecfd;
	}

	.risk-map__text {
		margin-top: 32px;
		font-size: 16px;
		line-height: 120%;
		font-weight: 500;
	}
	.risk-map__title {
		margin: 0;
		font-size: 32px;
		font-weight: 600;
		line-height: 1;
	}

	.risk-map__aside {
		position: absolute;
		top: 0;
		left: 0;
		display: flex;
		flex-direction: column;
		padding: 20px;
		height: 100%;
		width: 32.85%;
		z-index: 10;
		background: #e5ecfd;
	}
	.risk-map__details {
		flex: 0 1 291px;
		min-height: 120px;
		margin-top: 56px;
		padding: 18px;
		overflow: auto;
		border: 2px dashed #182939;
		border-radius: 10px;
		font-size: 16px;
		line-height: 120%;
		h3 {
			margin: 0 0 20px;
			font-weight: bold;
		}

		p {
			margin: 0;
		}
	}
	.risk-map__placeholder {
		color: rgba(25, 50, 75, 0.6);
	}
	/* fits one screen: the scene keeps 16:9 and shrinks to the viewport height under the fixed header */
	.risk-map__inner {
		position: relative;
		width: 100%;
		max-width: min(1440px, calc((100vh - 69px) * 16 / 9));
	}
	.risk-map__img {
		display: flex;
		width: 100%;
		picture,
		img {
			display: flex;
			width: 100%;
			height: auto;
		}
	}
	.risk-map__points {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 10;
	}
	.risk-map__scene {
		position: relative;
		width: 100%;
		min-height: 260px;
		background: #b6c4ce;
	}
	.risk-map__point {
		position: absolute;
		display: flex;
		width: 24px;
		height: 24px;
		background: transparent;
		border: 0;
		padding: 0;
		border-radius: 50%;
		cursor: pointer;
		z-index: 1;
		&::before {
			position: absolute;
			content: '';
			display: flex;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			width: 24px;
			height: 24px;
			border-radius: 50%;
			background: rgba(255, 43, 31, 0.35);
			border: 3px solid #ff2b1f;
			box-shadow: 0 0 10px rgba(255, 43, 31, 0.9);
			box-sizing: border-box;
			z-index: -1;
			transition: background ease 0.15s;
			animation: risk-point-pulse 1.6s ease-out infinite;
		}
		&::after {
			position: absolute;
			content: '';
			inset: 0;
			box-sizing: border-box;
			background: #ff2b1f;
			border: 2px solid #ffffff;
			border-radius: 50%;
			box-shadow:
				0 0 0 2px rgba(255, 43, 31, 0.45),
				0 0 12px 2px rgba(255, 43, 31, 0.8);
			z-index: 0;
			transition:
				border ease 0.15s,
				background ease 0.15s;
		}
		&:hover,
		&:focus-visible,
		&[aria-pressed='true'],
		&.risk-map__point--active {
			&::before {
				background: rgba(255, 255, 255, 0.5);
				animation: none;
			}
			&::after {
				background: #ffffff;
				border: 2px solid #112233;
				box-shadow: 0 0 12px 2px rgba(255, 255, 255, 0.8);
			}
		}
	}
	@keyframes risk-point-pulse {
		0% {
			transform: translate(-50%, -50%) scale(1);
			opacity: 1;
		}
		80%,
		100% {
			transform: translate(-50%, -50%) scale(3.2);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.risk-map__point::before {
			animation: none;
		}
	}

	.risk-map__point:nth-child(1) {
		top: 65%;
		left: 43.2%;
	}
	.risk-map__point:nth-child(2) {
		top: 26.3%;
		left: 65.4%;
		&::before {
			animation-delay: 0.35s;
		}
	}
	.risk-map__point:nth-child(3) {
		top: 41.4%;
		left: 80.9%;
		&::before {
			animation-delay: 0.7s;
		}
	}
	.risk-map__point:nth-child(4) {
		top: 55.3%;
		left: 60.8%;
		&::before {
			animation-delay: 1.05s;
		}
	}
	.risk-map__point:nth-child(5) {
		top: 83.6%;
		left: 67.7%;
		&::before {
			animation-delay: 1.4s;
		}
	}

	.risk-map__bubble {
		display: none;
	}

	@media (width < 960px) {
		.risk-map__inner {
			display: flex;
			flex-direction: column;
			max-width: none;
			padding: 80px 0 0;
		}
		.risk-map__aside {
			display: contents;
		}
		.risk-map__title,
		.risk-map__text {
			padding: 0 20px;
		}
		.risk-map__title {
			font-size: 34px;
			line-height: 36px;
		}
		.risk-map__text {
			margin: 16px 0 24px;
			font-size: 17px;
			line-height: 26px;
			font-weight: 400;
		}
		.risk-map__details {
			display: none;
		}
		.risk-map__scene {
			min-height: auto;
		}
		.risk-map__point {
			transform: translate(-50%, -50%);
		}
		.risk-map__point:nth-child(1) {
			top: 66.1%;
			left: 16.7%;
		}
		.risk-map__point:nth-child(2) {
			top: 28%;
			left: 55.9%;
		}
		.risk-map__point:nth-child(3) {
			top: 43.3%;
			left: 83.4%;
		}
		.risk-map__point:nth-child(4) {
			top: 56.9%;
			left: 47.5%;
		}
		.risk-map__point:nth-child(5) {
			top: 85.2%;
			left: 59.8%;
		}
		.risk-map__bubble {
			position: absolute;
			display: block;
			left: 12px;
			right: 12px;
			max-width: 520px;
			margin: 0 auto;
			padding: 14px 40px 16px 16px;
			background: var(--color-white);
			color: var(--black-100);
			box-shadow: 0 12px 32px rgba(11, 32, 52, 0.28);
			z-index: 20;
			/* taps go through to the points underneath, only the close button is interactive */
			pointer-events: none;
			h3 {
				margin: 0 0 8px;
				font-size: 16px;
				line-height: 120%;
			}
			p {
				margin: 0;
				font-size: 14px;
				line-height: 130%;
			}
			/* tail pointing at the tapped point */
			&::after {
				position: absolute;
				content: '';
				left: clamp(16px, var(--tail-x, 50%), calc(100% - 16px));
				bottom: -9px;
				width: 18px;
				height: 18px;
				background: inherit;
				transform: translateX(-50%) rotate(45deg);
			}
			&.risk-map__bubble--below::after {
				top: -9px;
				bottom: auto;
			}
			&[hidden] {
				display: none;
			}
		}
		.risk-map__bubble-close {
			position: absolute;
			top: 6px;
			right: 6px;
			width: 32px;
			height: 32px;
			padding: 0;
			border: 0;
			background: transparent;
			color: inherit;
			font-size: 24px;
			line-height: 1;
			cursor: pointer;
			pointer-events: auto;
		}
	}
</style>
