---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/_main.css";

const title = "Удокан — это вы";
const description = "Интерактивная игра ко Дню металлурга от Удоканской меди.";
const url = new URL(Astro.url.pathname, Astro.site);
const cover = new URL("/cover.jpg", Astro.site);
---

<head>
  <meta charset="utf-8" />
  <Font cssVariable="--font-onest" preload />
  <link rel="icon" href="/favicon.svg" />

  <link
    rel="icon"
    href="/favicon-light.svg"
    media="(prefers-color-scheme: light)"
  />

  <link
    rel="icon"
    href="/favicon-dark.svg"
    media="(prefers-color-scheme: dark)"
  />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content="Удоканская медь" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={cover} />
  <meta property="og:image:secure_url" content={cover} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Карьер Удокана с логотипом компании" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={cover} />
  <meta
    name="twitter:image:alt"
    content="Карьер Удокана с логотипом компании"
  />
  <script>
    type PreparationEvent = Event & {
      loader: () => Promise<void>;
      newDocument: Document;
      signal: AbortSignal;
    };

    const imageLoadTimeout = 15_000;
    const transitionImageSelector = "[data-transition-image] img";

    function isIOS() {
      return (
        /iP(ad|hone|od)/.test(navigator.userAgent) ||
        (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1)
      );
    }

    function addIOSQuestionTransitionStyle(
      newDocument: Document,
      isQuestionToQuestion: boolean,
    ) {
      const style = newDocument.createElement("style");
      style.dataset.iosQuestionTransitionStyle = "true";
      const rootTransition = isQuestionToQuestion
        ? `
        /*
         * Keep the root snapshot dimensions fixed on iOS. WebKit can round the
         * two independently moving snapshot edges to different device pixels.
         * The incoming scene starts one CSS pixel closer to the viewport, so it
         * always overlaps the outgoing scene instead of revealing the page
         * background between them.
         */
        @keyframes ios-question-root-out-forward {
          from {
            transform: translateY(0);
          }

          to {
            transform: translateY(-100%);
          }
        }

        @keyframes ios-question-root-in-forward {
          from {
            transform: translateY(calc(100% - 1px));
          }

          to {
            transform: translateY(0);
          }
        }

        @keyframes ios-question-root-out-back {
          from {
            transform: translateY(0);
          }

          to {
            transform: translateY(100%);
          }
        }

        @keyframes ios-question-root-in-back {
          from {
            transform: translateY(calc(-100% + 1px));
          }

          to {
            transform: translateY(0);
          }
        }

        @media (max-width: 959px) {
          @keyframes ios-question-root-out-forward {
            from {
              transform: translateX(0);
            }

            to {
              transform: translateX(-100%);
            }
          }

          @keyframes ios-question-root-in-forward {
            from {
              transform: translateX(calc(100% - 1px));
            }

            to {
              transform: translateX(0);
            }
          }

          @keyframes ios-question-root-out-back {
            from {
              transform: translateX(0);
            }

            to {
              transform: translateX(100%);
            }
          }

          @keyframes ios-question-root-in-back {
            from {
              transform: translateX(calc(-100% + 1px));
            }

            to {
              transform: translateX(0);
            }
          }
        }

        ::view-transition-group(root) {
          animation: none !important;
        }

        ::view-transition-image-pair(root) {
          isolation: auto !important;
        }

        ::view-transition-old(root) {
          animation: ios-question-root-out-forward 1.5s cubic-bezier(0.4, 0, 0.2, 1) both !important;
          mix-blend-mode: normal !important;
        }

        ::view-transition-new(root) {
          animation: ios-question-root-in-forward 1.5s cubic-bezier(0.4, 0, 0.2, 1) both !important;
          mix-blend-mode: normal !important;
          opacity: 1 !important;
        }

        [data-astro-transition="back"]::view-transition-old(root) {
          animation-name: ios-question-root-out-back !important;
        }

        [data-astro-transition="back"]::view-transition-new(root) {
          animation-name: ios-question-root-in-back !important;
        }
      `
        : `
        ::view-transition-old(root) {
          animation: page-slide-out-up 1.5s cubic-bezier(0.4, 0, 0.2, 1) both !important;
        }

        ::view-transition-new(root) {
          animation: none !important;
          opacity: 0 !important;
        }

        [data-astro-transition="back"]::view-transition-old(root) {
          animation-name: page-slide-out-down !important;
        }
      `;
      newDocument.head.append(style);
    }

    function waitForImage(image: HTMLImageElement, signal: AbortSignal) {
      return new Promise<void>((resolve) => {
        const preload = new Image();
        const picture = image.closest("picture");
        const source = picture
          ? [...picture.querySelectorAll("source")].find(
              (candidate) =>
                !candidate.media || window.matchMedia(candidate.media).matches,
            )
          : undefined;
        let completed = false;
        let timeout: ReturnType<typeof setTimeout> | undefined;

        const finish = () => {
          if (completed) return;
          completed = true;
          if (timeout) clearTimeout(timeout);
          signal.removeEventListener("abort", finish);
          preload.onload = null;
          preload.onerror = null;
          resolve();
        };

        const decode = async () => {
          try {
            await preload.decode();
          } catch {
            // A failed image must not block navigation.
          }

          finish();
        };

        signal.addEventListener("abort", finish, { once: true });
        preload.onload = decode;
        preload.onerror = finish;
        timeout = setTimeout(finish, imageLoadTimeout);

        if (source) {
          preload.sizes = source?.sizes || image.sizes;
          preload.srcset = source?.srcset || image.srcset;
          preload.src = image.src;
        } else {
          preload.sizes = image.sizes;
          preload.srcset = image.srcset;
          preload.src = image.currentSrc || image.src;
        }

        if (preload.complete) void decode();
        if (signal.aborted) finish();
      });
    }

    document.addEventListener("astro:before-preparation", (event) => {
      const preparation = event as PreparationEvent;
      const loadPage = preparation.loader;

      preparation.loader = async () => {
        await loadPage();
        const isIOSSceneExit =
          isIOS() &&
          (document.querySelector(".question") ||
            document.querySelector("#result-message") ||
            document.querySelector(".main"));
        const isIOSQuestionToQuestion =
          isIOSSceneExit &&
          document.querySelector(".question") &&
          preparation.newDocument.querySelector(".question");

        if (isIOSSceneExit) {
          addIOSQuestionTransitionStyle(
            preparation.newDocument,
            Boolean(isIOSQuestionToQuestion),
          );

          document
            .querySelectorAll<HTMLElement>(
              ".question [data-astro-transition-scope], .main[data-astro-transition-scope]",
            )
            .forEach((layer) => {
              layer.style.viewTransitionName = "none";
            });
        }

        const transitionImages = [
          ...preparation.newDocument.querySelectorAll<HTMLImageElement>(
            transitionImageSelector,
          ),
        ];
        const images =
          transitionImages.length > 0
            ? transitionImages
            : [...preparation.newDocument.images];

        await Promise.all(
          images.map((image) => waitForImage(image, preparation.signal)),
        );
      };
    });

    document.addEventListener("animationend", (event) => {
      const animation = event as AnimationEvent;

      if (animation.pseudoElement !== "::view-transition-old(root)") return;

      document
        .querySelector(`style[data-ios-question-transition-style]`)
        ?.remove();
    });
  </script>
  <ClientRouter />
</head>
