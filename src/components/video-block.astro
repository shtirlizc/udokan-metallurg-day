---
import { Image } from "astro:assets";
import Hexagonal from "./hexagonal.astro";

interface Props {
  id: string;
  title: string;
  video: {
    mobile: string;
    desktop: string;
  };
  dialogLabel: string;
  bg: {
    mobile: string;
    desktop: string;
  };
  charts?: {
    left: {
      mobile: ImageMetadata;
      desktop: ImageMetadata;
    };
    right: {
      mobile: ImageMetadata;
      desktop: ImageMetadata;
    };
  };
}

const { id, title, video, dialogLabel, bg, charts = null } = Astro.props;
---

<section
  class="video-block"
  style={`--video-block-background-mobile: url("${bg.mobile}"); --video-block-background-desktop: url("${bg.desktop}")`}
>
  {
    charts && (
      <div class="video-block__charts">
        <div class="left">
          <picture>
            <source
              media="(min-width: 960px)"
              srcset={charts.left.desktop.src}
            />
            <Image src={charts.left.mobile} alt="" />
          </picture>
        </div>
        <div class="right">
          <picture>
            <source
              media="(min-width: 960px)"
              srcset={charts.right.desktop.src}
            />
            <Image src={charts.right.mobile} alt="" />
          </picture>
        </div>
      </div>
    )
  }

  <ul class="video-block__tags">
    <slot name="tags" />
  </ul>

  <h2>{title}</h2>

  <Hexagonal id={`${id}-video-trigger`}>Смотреть</Hexagonal>
</section>

<dialog id={`${id}-video`} class="video-dialog" aria-label={dialogLabel}>
  <div class="video-dialog__wrap is-paused">
    <button
      type="button"
      class="video-dialog__close"
      aria-label="Закрыть видео"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    <video playsinline preload="metadata">
      <source src={video.desktop} type="video/mp4" media="(min-width: 768px)" />
      <source src={video.mobile} type="video/mp4" />
      Ваш браузер не поддерживает воспроизведение видео.
    </video>

    <button
      type="button"
      class="video-dialog__toggle"
      aria-label="Продолжить воспроизведение"
    >
      <span class="video-dialog__play" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <path d="M52 32 20 51V13l32 19Z"></path>
        </svg>
      </span>
    </button>

    <input
      class="video-dialog__progress"
      type="range"
      min="0"
      max="100"
      step="0.1"
      value="0"
      aria-label="Перемотать видео"
      aria-valuetext="0:00 из 0:00"
    />
  </div>
</dialog>

<style>
  .video-block {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background-image: var(--video-block-background-mobile);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: var(--space8);

    /* desktop */
    @media (width >= 960px) {
      min-height: 100vh;
      background-image: var(--video-block-background-desktop);
      background-position: left;
    }

    /* widescreen */
    @media (width >= 1200px) {
      background-position: center;
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        180deg,
        #171d2c 0%,
        rgba(23, 29, 44, 0.3) 50.48%,
        rgba(255, 255, 255, 0) 100%
      );

      /* desktop */
      @media (width >= 960px) {
        height: 40%;
      }
    }

    & .video-block__tags {
      padding: 0;
      display: flex;
      gap: 5px;
      position: absolute;
      bottom: var(--space16);
      left: 50%;
      transform: translate(-50%);

      /* desktop */
      @media (width >= 960px) {
        bottom: auto;
        top: var(--space20);
        left: var(--space24);
        transform: translate(0);
      }

      &:empty {
        display: none;
      }
    }

    & .video-block__charts {
      pointer-events: none;

      picture {
        display: flex;
        align-items: flex-end;
      }

      .left {
        position: absolute;
        left: 0;
        bottom: 0;
        max-width: 64%;
        max-height: 75%;

        /* desktop */
        @media (width >= 960px) {
          max-width: 510px;
          left: 25px;
          max-height: 85%;
        }

        img {
          width: 100%;
          height: auto;
        }
      }

      .right {
        position: absolute;
        right: 0;
        bottom: 0;
        max-width: 58.5%;
        max-height: 80%;

        /* desktop */
        @media (width >= 960px) {
          max-width: 560px;
          max-height: 90%;
        }

        img {
          width: 100%;
          height: auto;
        }
      }
    }

    h2 {
      position: absolute;
      top: 0;
      width: 100%;
      font-weight: 700;
      font-size: 20px;
      line-height: 105%;
      text-align: center;
      white-space: pre-line;
      padding: var(--space20);
      color: var(--color-white);
      max-width: 70vw;
      left: 50%;
      transform: translate(-50%);

      /* desktop */
      @media (width >= 960px) {
        padding: var(--space40);
        font-size: 27px;
        max-width: 50vw;
      }
    }
  }

  .video-dialog {
    --video-aspect-ratio: 5 / 4;
    --video-height-constrained-width: calc(125dvh - 40px);

    position: fixed;
    inset: 0;
    width: min(
      1200px,
      calc(100vw - 32px),
      var(--video-height-constrained-width)
    );
    height: fit-content;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity var(--transition-long) var(--transition-f),
      transform var(--transition-long) var(--transition-f);

    @media (width >= 960px) {
      --video-aspect-ratio: 16 / 9;
      --video-height-constrained-width: calc(177.7778dvh - 56.8889px);
    }

    &[open] {
      opacity: 1;
      transform: scale(1);
    }

    &[open].is-closing {
      opacity: 0;
      transform: scale(0.85);
    }

    &::backdrop {
      background-color: rgb(0 0 0 / 72%);
      opacity: 0;
      backdrop-filter: blur(6px);
      transition: opacity var(--transition-long) var(--transition-f);
    }

    &[open]::backdrop {
      opacity: 1;
    }

    &[open].is-closing::backdrop {
      opacity: 0;
    }
  }

  @starting-style {
    .video-dialog[open] {
      opacity: 0;
      transform: scale(0.85);
    }

    .video-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  .video-dialog__wrap {
    position: relative;
    width: 100%;
    aspect-ratio: var(--video-aspect-ratio);
    overflow: hidden;
    border-radius: var(--border-radius12);
    background: #000;
    box-shadow: 0 24px 80px rgb(0 0 0 / 45%);

    & video {
      display: block;
      width: 100%;
      height: 100%;
      aspect-ratio: var(--video-aspect-ratio);
      object-fit: contain;
    }
  }

  .video-dialog__close {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 10px;
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: rgb(17 3 3 / 70%);
    color: var(--color-white);
    place-items: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      background-color var(--transition-short) var(--transition-f),
      transform var(--transition-short) var(--transition-f);

    &:hover {
      background: rgb(17 3 3 / 90%);
      transform: scale(1.06);
    }

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: 2px;
    }

    & svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
    }
  }

  .video-dialog__toggle {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    place-items: center;
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: -4px;
    }
  }

  .video-dialog__play {
    opacity: 0;
    transform: scale(0.5);
    pointer-events: none;
    filter: drop-shadow(0 4px 14px rgb(0 0 0 / 50%));
    transition:
      opacity var(--transition) var(--transition-f),
      transform var(--transition) var(--transition-f);

    & svg {
      display: block;
      width: clamp(56px, 8vw, 96px);
      height: clamp(56px, 8vw, 96px);
      fill: currentColor;
    }
  }

  .video-dialog__wrap.is-paused .video-dialog__play {
    opacity: 1;
    transform: scale(1);
  }

  .video-dialog__wrap.is-closing .video-dialog__play {
    opacity: 0;
    transform: scale(0.5);
  }

  .video-dialog__progress {
    --video-progress: 0%;

    position: absolute;
    z-index: 3;
    right: 16px;
    bottom: 12px;
    left: 16px;
    width: calc(100% - 32px);
    height: 16px;
    margin: 0;
    padding: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;

    &::-webkit-slider-runnable-track {
      height: 3px;
      border-radius: 999px;
      background: linear-gradient(
        to right,
        var(--color-white) var(--video-progress),
        rgb(255 255 255 / 35%) var(--video-progress)
      );
    }

    &::-webkit-slider-thumb {
      width: 12px;
      height: 12px;
      margin-top: -4.5px;
      appearance: none;
      border: 0;
      border-radius: 50%;
      background: var(--color-white);
      box-shadow: 0 1px 4px rgb(0 0 0 / 30%);
    }

    &::-moz-range-track {
      height: 3px;
      border-radius: 999px;
      background: rgb(255 255 255 / 35%);
    }

    &::-moz-range-progress {
      height: 3px;
      border-radius: 999px;
      background: var(--color-white);
    }

    &::-moz-range-thumb {
      width: 12px;
      height: 12px;
      border: 0;
      border-radius: 50%;
      background: var(--color-white);
      box-shadow: 0 1px 4px rgb(0 0 0 / 30%);
    }

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: 3px;
    }

    @media (width >= 960px) {
      right: 24px;
      bottom: 16px;
      left: 24px;
      width: calc(100% - 48px);
    }
  }
</style>

<script>
  function initVideoBlock(dialog: HTMLDialogElement) {
    const trigger = document.getElementById(`${dialog.id}-trigger`);
    const videoWrap = dialog?.querySelector<HTMLElement>(".video-dialog__wrap");
    const video = dialog?.querySelector<HTMLVideoElement>("video");
    const toggle = dialog?.querySelector<HTMLButtonElement>(
      ".video-dialog__toggle",
    );
    const closeButton = dialog?.querySelector<HTMLButtonElement>(
      ".video-dialog__close",
    );
    const progress = dialog?.querySelector<HTMLInputElement>(
      ".video-dialog__progress",
    );

    if (
      !trigger ||
      !dialog ||
      !videoWrap ||
      !video ||
      !toggle ||
      !closeButton ||
      !progress ||
      dialog.dataset.initialized
    )
      return;

    dialog.dataset.initialized = "true";

    let closeFallback: number | undefined;
    let closeOnTransitionEnd: ((event: TransitionEvent) => void) | undefined;

    const formatTime = (time: number) => {
      if (!Number.isFinite(time)) return "0:00";

      const totalSeconds = Math.max(0, Math.floor(time));
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = String(totalSeconds % 60).padStart(2, "0");

      return `${minutes}:${seconds}`;
    };

    const updateProgress = () => {
      const duration = video.duration;
      const value =
        Number.isFinite(duration) && duration > 0
          ? (video.currentTime / duration) * 100
          : 0;

      progress.value = String(value);
      progress.style.setProperty("--video-progress", `${value}%`);
      progress.setAttribute(
        "aria-valuetext",
        `${formatTime(video.currentTime)} из ${formatTime(duration)}`,
      );
    };

    const resetProgress = () => {
      progress.value = "0";
      progress.style.setProperty("--video-progress", "0%");
      progress.setAttribute("aria-valuetext", "0:00 из 0:00");
    };

    const cancelPendingClose = () => {
      if (closeFallback) window.clearTimeout(closeFallback);
      if (closeOnTransitionEnd) {
        dialog.removeEventListener("transitionend", closeOnTransitionEnd);
      }

      closeFallback = undefined;
      closeOnTransitionEnd = undefined;
    };

    const updatePlaybackState = () => {
      const isPaused = video.paused || video.ended;

      videoWrap.classList.toggle("is-paused", isPaused);
      toggle.setAttribute(
        "aria-label",
        isPaused ? "Продолжить воспроизведение" : "Поставить на паузу",
      );
    };

    const playVideo = () => {
      cancelPendingClose();
      if (video.ended) video.currentTime = 0;
      void video.play().catch(updatePlaybackState);
    };

    const finishClose = () => {
      cancelPendingClose();
      if (dialog.open) dialog.close();
      dialog.classList.remove("is-closing");
      videoWrap.classList.remove("is-closing");
      video.currentTime = 0;
      resetProgress();
    };

    const closeDialog = () => {
      if (!dialog.open || dialog.classList.contains("is-closing")) return;

      video.pause();
      updatePlaybackState();
      dialog.classList.add("is-closing");
      videoWrap.classList.add("is-closing");

      closeOnTransitionEnd = (event) => {
        if (event.target === dialog && event.propertyName === "opacity") {
          finishClose();
        }
      };

      dialog.addEventListener("transitionend", closeOnTransitionEnd);
      closeFallback = window.setTimeout(finishClose, 600);
    };

    trigger.addEventListener("click", () => {
      cancelPendingClose();
      dialog.classList.remove("is-closing");
      videoWrap.classList.remove("is-closing");
      if (!dialog.open) dialog.showModal();
      playVideo();
    });

    closeButton.addEventListener("click", closeDialog);

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDialog();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeDialog();
    });

    toggle.addEventListener("click", () => {
      if (video.paused || video.ended) {
        playVideo();
      } else {
        video.pause();
      }
    });

    progress.addEventListener("input", () => {
      const duration = video.duration;
      const value = Number(progress.value);

      progress.style.setProperty("--video-progress", `${value}%`);

      if (Number.isFinite(duration) && duration > 0) {
        video.currentTime = (value / 100) * duration;
        updateProgress();
      }
    });

    video.addEventListener("play", updatePlaybackState);
    video.addEventListener("pause", updatePlaybackState);
    video.addEventListener("ended", updatePlaybackState);
    video.addEventListener("loadedmetadata", updateProgress);
    video.addEventListener("durationchange", updateProgress);
    video.addEventListener("timeupdate", updateProgress);
  }

  function initVideoBlocks() {
    document
      .querySelectorAll<HTMLDialogElement>(".video-dialog")
      .forEach(initVideoBlock);
  }

  document.addEventListener("astro:page-load", initVideoBlocks);
</script>
