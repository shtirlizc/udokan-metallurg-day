---
import Link from "./link.astro";
import type { CollectionEntry } from "astro:content";
import Answer from "./answer.astro";

interface Props {
  question: CollectionEntry<"question">;
}

type QuestionAnswer = CollectionEntry<"question">["data"]["answers"][number];

const { question } = Astro.props;
const {
  questionNumber,
  questionText,
  correctAnswerId,
  answers,
  nextPage,
  isLast = false,
} = question.data;
---

<div class="quiz" data-question-number={questionNumber}>
  <div class="quiz__head">
    <h2>Вопрос {questionNumber}</h2>
    <p>
      {questionText}
    </p>
  </div>

  <ul class="quiz__body">
    {
      answers.map((answer: QuestionAnswer) => {
        return (
          <li>
            <Answer answer={answer} correctAnswerId={correctAnswerId} />
          </li>
        );
      })
    }
  </ul>

  <div class="quiz__next">
    <Link href={`/${nextPage}`} block disabled>
      {isLast ? "Получить результаты" : "Следующий вопрос"}
    </Link>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  type AnswerType = "success" | "fail";

  function initQuiz() {
    const quiz = document.querySelector<HTMLElement>(".quiz");

    if (!quiz || quiz.dataset.initialized === "true") return;

    const questionNumber = quiz.dataset.questionNumber;
    const nextLink = quiz.querySelector<HTMLAnchorElement>("a");

    if (!nextLink || !questionNumber) return;

    quiz.dataset.initialized = "true";

    const answers = quiz.querySelectorAll<HTMLButtonElement>("button");
    answers.forEach((answer) => {
      answer.addEventListener("click", () => {
        const answerId = answer.dataset.number;
        const correctAnswerId = answer.dataset.correctAnswerId;

        if (!answerId || !correctAnswerId) {
          console.error("answerId and correctAnswerId are required");
          return;
        }

        const answerType: AnswerType =
          answerId === correctAnswerId ? "success" : "fail";

        answer.classList.add(answerType);
        saveToStorage(questionNumber, answerType);
        disableAnswerButtons(answers);
        activateNextLink(nextLink);
        showComment(answer);
        answerAnimation(answerType, answer);
      });
    });
  }

  document.addEventListener("astro:page-load", initQuiz);

  function saveToStorage(questionId: string, answerType: AnswerType) {
    const KEY = "udokan_quiz";
    const savedAnswers = sessionStorage.getItem(KEY);

    let answers: Record<string, AnswerType> = {};

    if (savedAnswers) {
      try {
        const parsedAnswers = JSON.parse(savedAnswers);

        if (
          parsedAnswers &&
          typeof parsedAnswers === "object" &&
          !Array.isArray(parsedAnswers)
        ) {
          answers = parsedAnswers;
        }
      } catch {
        answers = {};
      }
    }

    answers[questionId] = answerType;
    sessionStorage.setItem(KEY, JSON.stringify(answers));
  }

  function disableAnswerButtons(answers: NodeListOf<HTMLButtonElement>) {
    answers.forEach((answer) => {
      answer.disabled = true;
    });
  }

  function activateNextLink(nextLink: HTMLAnchorElement) {
    nextLink.classList.remove("disabled");
  }

  function showComment(answer: HTMLButtonElement) {
    const comment = answer.querySelector(".answer__comment");

    const tl = gsap.timeline();
    tl.set(comment, {
      display: "block",
      height: 0,
      opacity: 0,
      overflow: "hidden",
    }).to(comment, {
      height: "auto",
      opacity: 1,
      duration: 0.4,
      ease: "back.out",
    });
  }

  function answerAnimation(answerType: AnswerType, answer: HTMLButtonElement) {
    const answerBody = answer.querySelector<HTMLElement>(".answer__body");

    if (!answerBody) return;

    gsap.killTweensOf(answerBody);

    if (answerType === "success") {
      gsap
        .timeline({ defaults: { ease: "power2.out" } })
        .set(answerBody, {
          transformOrigin: "50% 50%",
          x: 0,
          rotate: 0,
          scale: 1,
        })
        .to(answerBody, {
          scale: 1.04,
          rotate: -1.5,
          duration: 0.18,
        })
        .to(answerBody, {
          scale: 0.98,
          rotate: 1.5,
          duration: 0.15,
        })
        .to(answerBody, {
          scale: 1.02,
          rotate: -0.8,
          duration: 0.15,
        })
        .to(answerBody, {
          scale: 1,
          rotate: 0,
          duration: 0.27,
          ease: "back.out(2)",
        });

      return;
    }

    gsap.fromTo(
      answerBody,
      { x: 0 },
      {
        keyframes: [
          { x: -10, duration: 0.09 },
          { x: 8, duration: 0.09 },
          { x: -6, duration: 0.09 },
          { x: 4, duration: 0.09 },
          { x: -2, duration: 0.075 },
          { x: 0, duration: 0.075 },
        ],
        ease: "power2.out",
      },
    );
  }
</script>

<style>
  .quiz {
    background-color: var(--white-0);
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;

    /* desktop */
    @media (width >= 960px) {
      border-radius: 24px;
      padding: var(--space32);
    }

    & .quiz__head {
      h2 {
        font: var(--font-title-2);
      }

      p {
        margin-top: var(--space16);
        font: var(--font-text-medium);

        /* desktop */
        @media (width >= 960px) {
          margin-top: var(--space32);
        }
      }
    }

    & .quiz__body {
      margin-top: var(--space20);
      margin-bottom: var(--space40);
      list-style: none;
      padding: 0;
      display: grid;
      gap: var(--space);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space24);
        gap: var(--space8);
      }
    }

    & .quiz__next {
      margin-top: auto;
      margin-bottom: 0;
      position: sticky;
      bottom: 0;
      z-index: 1;
    }
  }
</style>
