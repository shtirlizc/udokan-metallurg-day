---
import Hexagon from "../assets/hexagon.svg";

interface Props {
  id?: string;
  popoverTarget?: string;
}

const { id, popoverTarget } = Astro.props;
---

<button id={id} type="button" class="btn" popovertarget={popoverTarget}>
  <Hexagon />
  <span>
    <slot />
  </span>
</button>

<style>
  .btn {
    --side: 150px;

    position: relative;
    display: inline-block;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;

    /* desktop */
    @media (width >= 960px) {
      --side: 270px;
    }

    &:hover svg {
      transform: rotate(60deg);
    }

    svg {
      width: var(--side);
      height: var(--side);
      transition: transform var(--transition-long) ease-in-out;
    }

    span {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-weight: 500;
      font-size: 16px;
      line-height: 140%;
      text-align: center;
      text-transform: uppercase;
      color: var(--color-white);
    }
  }
</style>
