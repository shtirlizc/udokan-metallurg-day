---
import { Image } from "astro:assets";

import Tag from "../tag.astro";
import charsImg from "./assets/metallurgist-day-chars.webp";
---

<section class="root">
  <div class="root__bg"></div>

  <div class="root__head">
    <ul>
      <Tag color="#C8FF00">Спецпроект</Tag>
    </ul>

    <h2>День металлурга</h2>
  </div>

  <div class="root__chars">
    <Image src={charsImg} alt="" />
  </div>

  <a href="/день-металлурга" class="link">День металлурга</a>
</section>

<style>
  .root {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    &:hover {
      .root__bg {
        transform: scale(1);
      }
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 60%;
      background: linear-gradient(
        180deg,
        #171d2c -3.55%,
        rgba(23, 29, 44, 0.3) 46.94%,
        rgba(255, 255, 255, 0) 96.45%
      );
      z-index: 1;
    }

    & .root__bg {
      position: absolute;
      inset: 0;
      background-image: url("./assets/metallurgist-day-bg.webp");
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      transform: scale(1.1);
      transition: transform var(--transition-long) ease-in-out;
    }

    & .root__head {
      padding: var(--space20);

      /* desktop */
      @media (width >= 960px) {
        padding: 30px;
      }
    }

    ul,
    h2 {
      position: relative;
      z-index: 1;
      padding: 0;
    }

    ul {
      display: flex;
      gap: 5px;
    }

    h2 {
      margin-top: 15px;
      font-family: var(--font-bebas-neue-cyrillic), sans-serif;
      font-weight: 700;
      font-size: 50px;
      line-height: 90%;
      text-transform: uppercase;
      color: var(--color-white);

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space20);
        font-size: 100px;
      }
    }

    & .root__chars {
      flex-grow: 1;
      position: relative;
      z-index: 1;
      font-size: 0;
      display: flex;
      justify-content: flex-end;
      align-items: flex-end;

      img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }
    }

    a {
      position: absolute;
      inset: 0;
      z-index: 2;
      font-size: 0;
    }
  }
</style>
