---
import { withBase } from "../../utils/paths";
import { Image } from "astro:assets";

import Tag from "../tag.astro";
import charsImg from "./assets/metallurgist-day-chars.webp";
---

<section class="root" data-chars-reveal>
  <div class="root__bg"></div>

  <div class="root__head">
    <ul>
      <Tag color="#C8FF00">Спецпроект</Tag>
    </ul>

    <h2>День металлурга</h2>
  </div>

  <div class="root__chars">
    <Image src={charsImg} alt="" />
  </div>

  <a href={withBase("/день-металлурга/")}>День металлурга</a>
</section>

<script>
  function initMetallurgistDayCharsReveal() {
    const sections = document.querySelectorAll<HTMLElement>(
      ".root[data-chars-reveal]",
    );

    sections.forEach((section) => {
      if (section.dataset.revealInitialized) return;

      section.dataset.revealInitialized = "true";
      let frameId: number | undefined;

      const cleanup = () => {
        window.removeEventListener("scroll", queueRevealCheck);
        window.removeEventListener("resize", queueRevealCheck);
        document.removeEventListener("astro:before-swap", cleanup);
        if (frameId) window.cancelAnimationFrame(frameId);
      };

      const revealIfVisible = () => {
        frameId = undefined;

        const rect = section.getBoundingClientRect();
        const visibleHeight = Math.max(
          0,
          Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0),
        );
        const requiredVisibleHeight =
          Math.min(rect.height, window.innerHeight) * 0.8;

        if (visibleHeight < requiredVisibleHeight) return;

        section.classList.add("is-chars-visible");
        cleanup();
      };

      function queueRevealCheck() {
        if (frameId) return;
        frameId = window.requestAnimationFrame(revealIfVisible);
      }

      window.addEventListener("scroll", queueRevealCheck, { passive: true });
      window.addEventListener("resize", queueRevealCheck);
      document.addEventListener("astro:before-swap", cleanup, { once: true });
      queueRevealCheck();
    });
  }

  document.addEventListener("astro:page-load", initMetallurgistDayCharsReveal);
</script>

<style>
  .root {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    &:hover .root__chars {
      --chars-scale: 1.05;

      transition: transform var(--transition-long);
    }

    &.is-chars-visible .root__chars {
      --chars-translate-x: 0px;

      opacity: 1;
    }

    &.is-chars-visible .root__bg {
      transform: scale(1);
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 60%;
      background: linear-gradient(
        180deg,
        #171d2c -3.55%,
        rgba(23, 29, 44, 0.3) 46.94%,
        rgba(255, 255, 255, 0) 96.45%
      );
      z-index: 1;
    }

    & .root__bg {
      position: absolute;
      inset: 0;
      background-image: url("./assets/metallurgist-day-bg.webp");
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
      transform: scale(1.2);
      transition: transform calc(1.5 * var(--transition-long))
        var(--transition-f);

      @media (prefers-reduced-motion: reduce) {
        transform: scale(1);
        transition: none;
      }
    }

    & .root__head {
      padding: var(--space20);

      /* desktop */
      @media (width >= 960px) {
        padding: 30px;
      }
    }

    ul,
    h2 {
      position: relative;
      z-index: 1;
      padding: 0;
    }

    ul {
      display: flex;
      gap: 5px;
    }

    h2 {
      margin-top: 15px;
      font-family: var(--font-bebas-neue-cyrillic), sans-serif;
      font-weight: 700;
      font-size: 50px;
      line-height: 90%;
      text-transform: uppercase;
      color: var(--color-white);
      letter-spacing: -0.5px;

      /* desktop */
      @media (width >= 960px) {
        margin-top: var(--space20);
        font-size: 100px;
        letter-spacing: -1px;
      }
    }

    & .root__chars {
      --chars-translate-x: clamp(48px, 8vw, 120px);
      --chars-scale: 1;

      flex-grow: 1;
      position: relative;
      z-index: 1;
      font-size: 0;
      display: flex;
      justify-content: flex-end;
      align-items: flex-end;
      margin-top: 4vh;
      opacity: 0;
      transform: translateX(var(--chars-translate-x)) scale(var(--chars-scale));
      transition:
        opacity calc(1.5 * var(--transition-long)) var(--transition-f),
        transform calc(1.5 * var(--transition-long)) var(--transition-f);

      /* desktop */
      @media (width >= 960px) {
        margin-top: 0;
      }

      img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      @media (prefers-reduced-motion: reduce) {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    a {
      position: absolute;
      inset: 0;
      z-index: 2;
      font-size: 0;
    }
  }
</style>
