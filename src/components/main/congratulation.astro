---
import { withBase } from "../../utils/paths";
import VideoBlock from "../video-block.astro";
import desktopBackground from "./assets/congratulation-desktop.webp";
import mobileBackground from "./assets/congratulation-mobile.webp";
---

<VideoBlock
  id="congratulation"
  title={`Анимационный ролик\nко Дню Металлурга`}
  video={{
    mobile: withBase("/video/congratulation-mobile.mp4"),
    desktop: withBase("/video/congratulation-desktop.mp4"),
  }}
  dialogLabel="Анимационный ролик ко Дню Металлурга"
  bg={{
    mobile: mobileBackground.src,
    desktop: desktopBackground.src,
  }}
/>
