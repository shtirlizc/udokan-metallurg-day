---
import Hexagonal from "../hexagonal.astro";
---

<section class="congratulation">
  <h2>
    Анимационный ролик
    <br />
    ко Дню Металлурга
  </h2>

  <Hexagonal id="congratulation-video-trigger"> Смотреть </Hexagonal>
</section>

<dialog
  id="congratulation-video"
  class="video-dialog"
  aria-label="Анимационный ролик ко Дню Металлурга"
>
  <div class="video-dialog__wrap is-paused">
    <button
      type="button"
      class="video-dialog__close"
      aria-label="Закрыть видео"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    <video playsinline preload="metadata">
      <source
        src="/video/congratulation-desktop.mp4"
        type="video/mp4"
        media="(min-width: 768px)"
      />
      <source src="/video/congratulation-mobile.mp4" type="video/mp4" />
      Ваш браузер не поддерживает воспроизведение видео.
    </video>

    <button
      type="button"
      class="video-dialog__toggle"
      aria-label="Продолжить воспроизведение"
    >
      <span class="video-dialog__play" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <path d="M52 32 20 51V13l32 19Z"></path>
        </svg>
      </span>
    </button>
  </div>
</dialog>

<style>
  .congratulation {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background-image: url("./assets/congratulation-mobile.webp");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-top: var(--space8);

    /* desktop */
    @media (width >= 960px) {
      min-height: 100vh;
      background-image: url("./assets/congratulation-desktop.webp");
      background-position: left;
    }

    /* widescreen */
    @media (width >= 1200px) {
      background-position: center;
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        180deg,
        #171d2c 0%,
        rgba(23, 29, 44, 0.3) 50.48%,
        rgba(255, 255, 255, 0) 100%
      );

      /* desktop */
      @media (width >= 960px) {
        height: 40%;
      }
    }

    h2 {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      font-weight: 700;
      font-size: 20px;
      line-height: 105%;
      text-align: center;
      padding: var(--space20);
      color: var(--color-white);

      /* desktop */
      @media (width >= 960px) {
        padding: var(--space40);
        font-size: 27px;
      }
    }
  }

  .video-dialog {
    --video-aspect-ratio: 5 / 4;
    --video-height-constrained-width: calc(125dvh - 40px);

    position: fixed;
    inset: 0;
    width: min(
      1200px,
      calc(100vw - 32px),
      var(--video-height-constrained-width)
    );
    height: fit-content;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity var(--transition-long) var(--transition-f),
      transform var(--transition-long) var(--transition-f);

    @media (width >= 960px) {
      --video-aspect-ratio: 16 / 9;
      --video-height-constrained-width: calc(177.7778dvh - 56.8889px);
    }

    &[open] {
      opacity: 1;
      transform: scale(1);
    }

    &[open].is-closing {
      opacity: 0;
      transform: scale(0.85);
    }

    &::backdrop {
      background-color: rgb(0 0 0 / 72%);
      opacity: 0;
      backdrop-filter: blur(6px);
      transition: opacity var(--transition-long) var(--transition-f);
    }

    &[open]::backdrop {
      opacity: 1;
    }

    &[open].is-closing::backdrop {
      opacity: 0;
    }
  }

  @starting-style {
    .video-dialog[open] {
      opacity: 0;
      transform: scale(0.85);
    }

    .video-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  .video-dialog__wrap {
    position: relative;
    width: 100%;
    aspect-ratio: var(--video-aspect-ratio);
    overflow: hidden;
    border-radius: var(--border-radius12);
    background: #000;
    box-shadow: 0 24px 80px rgb(0 0 0 / 45%);

    & video {
      display: block;
      width: 100%;
      height: 100%;
      aspect-ratio: var(--video-aspect-ratio);
      object-fit: contain;
    }
  }

  .video-dialog__close {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 10px;
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: rgb(17 3 3 / 70%);
    color: var(--color-white);
    place-items: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      background-color var(--transition-short) var(--transition-f),
      transform var(--transition-short) var(--transition-f);

    &:hover {
      background: rgb(17 3 3 / 90%);
      transform: scale(1.06);
    }

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: 2px;
    }

    & svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
    }
  }

  .video-dialog__toggle {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    place-items: center;
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: -4px;
    }
  }

  .video-dialog__play {
    opacity: 0;
    transform: scale(0.5);
    pointer-events: none;
    filter: drop-shadow(0 4px 14px rgb(0 0 0 / 50%));
    transition:
      opacity var(--transition) var(--transition-f),
      transform var(--transition) var(--transition-f);

    & svg {
      display: block;
      width: clamp(56px, 8vw, 96px);
      height: clamp(56px, 8vw, 96px);
      fill: currentColor;
    }
  }

  .video-dialog__wrap.is-paused .video-dialog__play {
    opacity: 1;
    transform: scale(1);
  }

  .video-dialog__wrap.is-closing .video-dialog__play {
    opacity: 0;
    transform: scale(0.5);
  }
</style>

<script>
  function initCongratulationVideo() {
    const trigger = document.getElementById("congratulation-video-trigger");
    const dialog = document.querySelector<HTMLDialogElement>(
      "#congratulation-video",
    );
    const videoWrap = dialog?.querySelector<HTMLElement>(".video-dialog__wrap");
    const video = dialog?.querySelector<HTMLVideoElement>("video");
    const toggle = dialog?.querySelector<HTMLButtonElement>(
      ".video-dialog__toggle",
    );
    const closeButton = dialog?.querySelector<HTMLButtonElement>(
      ".video-dialog__close",
    );

    if (
      !trigger ||
      !dialog ||
      !videoWrap ||
      !video ||
      !toggle ||
      !closeButton ||
      dialog.dataset.initialized
    )
      return;

    dialog.dataset.initialized = "true";

    let closeFallback: number | undefined;
    let closeOnTransitionEnd: ((event: TransitionEvent) => void) | undefined;

    const cancelPendingClose = () => {
      if (closeFallback) window.clearTimeout(closeFallback);
      if (closeOnTransitionEnd) {
        dialog.removeEventListener("transitionend", closeOnTransitionEnd);
      }

      closeFallback = undefined;
      closeOnTransitionEnd = undefined;
    };

    const updatePlaybackState = () => {
      const isPaused = video.paused || video.ended;

      videoWrap.classList.toggle("is-paused", isPaused);
      toggle.setAttribute(
        "aria-label",
        isPaused ? "Продолжить воспроизведение" : "Поставить на паузу",
      );
    };

    const playVideo = () => {
      cancelPendingClose();
      if (video.ended) video.currentTime = 0;
      void video.play().catch(updatePlaybackState);
    };

    const finishClose = () => {
      cancelPendingClose();
      if (dialog.open) dialog.close();
      dialog.classList.remove("is-closing");
      videoWrap.classList.remove("is-closing");
      video.currentTime = 0;
    };

    const closeDialog = () => {
      if (!dialog.open || dialog.classList.contains("is-closing")) return;

      video.pause();
      updatePlaybackState();
      dialog.classList.add("is-closing");
      videoWrap.classList.add("is-closing");

      closeOnTransitionEnd = (event) => {
        if (event.target === dialog && event.propertyName === "opacity") {
          finishClose();
        }
      };

      dialog.addEventListener("transitionend", closeOnTransitionEnd);
      closeFallback = window.setTimeout(finishClose, 600);
    };

    trigger.addEventListener("click", () => {
      cancelPendingClose();
      dialog.classList.remove("is-closing");
      videoWrap.classList.remove("is-closing");
      if (!dialog.open) dialog.showModal();
      playVideo();
    });

    closeButton.addEventListener("click", closeDialog);

    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeDialog();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeDialog();
    });

    toggle.addEventListener("click", () => {
      if (video.paused || video.ended) {
        playVideo();
      } else {
        video.pause();
      }
    });

    video.addEventListener("play", updatePlaybackState);
    video.addEventListener("pause", updatePlaybackState);
    video.addEventListener("ended", updatePlaybackState);
  }

  document.addEventListener("astro:page-load", initCongratulationVideo);
</script>
