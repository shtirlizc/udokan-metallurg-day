---
import Hexagonal from "../hexagonal.astro";
---

<section class="congratulation">
  <h2>
    Анимационный ролик
    <br />
    ко Дню Металлурга
  </h2>

  <Hexagonal
    id="congratulation-video-trigger"
    popoverTarget="congratulation-video"
  >
    Смотреть
  </Hexagonal>
</section>

<div
  id="congratulation-video"
  class="video-popover"
  popover="auto"
  role="dialog"
  aria-modal="true"
  aria-label="Анимационный ролик ко Дню Металлурга"
>
  <div class="video-popover__wrap is-paused">
    <button
      type="button"
      class="video-popover__close"
      popovertarget="congratulation-video"
      popovertargetaction="hide"
      aria-label="Закрыть видео"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    <video playsinline preload="metadata">
      <source src="/video/congratulation.mp4" type="video/mp4" />
      Ваш браузер не поддерживает воспроизведение видео.
    </video>

    <button
      type="button"
      class="video-popover__toggle"
      aria-label="Продолжить воспроизведение"
    >
      <span class="video-popover__play" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <path d="M52 32 20 51V13l32 19Z"></path>
        </svg>
      </span>
    </button>
  </div>
</div>

<script>
  function initCongratulationVideo() {
    const trigger = document.getElementById("congratulation-video-trigger");
    const popover = document.getElementById("congratulation-video");
    const videoWrap = popover?.querySelector<HTMLElement>(
      ".video-popover__wrap",
    );
    const video = popover?.querySelector<HTMLVideoElement>("video");
    const toggle = popover?.querySelector<HTMLButtonElement>(
      ".video-popover__toggle",
    );

    if (
      !trigger ||
      !popover ||
      !videoWrap ||
      !video ||
      !toggle ||
      popover.dataset.initialized
    )
      return;

    popover.dataset.initialized = "true";

    let resetFallback: number | undefined;
    let resetOnTransitionEnd: ((event: TransitionEvent) => void) | undefined;

    const cancelPendingReset = () => {
      if (resetFallback) window.clearTimeout(resetFallback);
      if (resetOnTransitionEnd) {
        popover.removeEventListener("transitionend", resetOnTransitionEnd);
      }

      resetFallback = undefined;
      resetOnTransitionEnd = undefined;
    };

    const resetVideoAfterClosing = () => {
      cancelPendingReset();

      const resetVideo = () => {
        if (!popover.matches(":popover-open")) video.currentTime = 0;
        cancelPendingReset();
      };

      resetOnTransitionEnd = (event) => {
        if (event.target === popover && event.propertyName === "opacity") {
          resetVideo();
        }
      };

      popover.addEventListener("transitionend", resetOnTransitionEnd);
      resetFallback = window.setTimeout(resetVideo, 600);
    };

    const updatePlaybackState = () => {
      const isPaused = video.paused || video.ended;

      videoWrap.classList.toggle("is-paused", isPaused);
      toggle.setAttribute(
        "aria-label",
        isPaused ? "Продолжить воспроизведение" : "Поставить на паузу",
      );
    };

    const playVideo = () => {
      cancelPendingReset();
      if (video.ended) video.currentTime = 0;
      void video.play().catch(updatePlaybackState);
    };

    trigger.addEventListener("click", playVideo);

    toggle.addEventListener("click", () => {
      if (video.paused || video.ended) {
        playVideo();
      } else {
        video.pause();
      }
    });

    video.addEventListener("play", updatePlaybackState);
    video.addEventListener("pause", updatePlaybackState);
    video.addEventListener("ended", updatePlaybackState);

    popover.addEventListener("beforetoggle", (event) => {
      videoWrap.classList.toggle(
        "is-closing",
        (event as ToggleEvent).newState === "closed",
      );
    });

    popover.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "open") {
        if (video.paused) void video.play().catch(() => {});
        return;
      }

      video.pause();
      updatePlaybackState();
      resetVideoAfterClosing();
    });
  }

  document.addEventListener("astro:page-load", initCongratulationVideo);
</script>

<style>
  .congratulation {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    background-image: url("./assets/congratulation-mobile.webp");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    justify-content: center;
    align-items: center;

    /* desktop */
    @media (width >= 960px) {
      min-height: 100vh;
      background-image: url("./assets/congratulation-desktop.webp");
    }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        180deg,
        #171d2c 0%,
        rgba(23, 29, 44, 0.3) 50.48%,
        rgba(255, 255, 255, 0) 100%
      );

      /* desktop */
      @media (width >= 960px) {
        height: 40%;
      }
    }

    h2 {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      font-weight: 700;
      font-size: 20px;
      line-height: 105%;
      text-align: center;
      padding: var(--space20);
      color: var(--color-white);

      /* desktop */
      @media (width >= 960px) {
        padding: var(--space40);
        font-size: 27px;
      }
    }
  }

  .video-popover {
    position: fixed;
    inset: 0;
    width: min(1200px, calc(100vw - 32px), calc(125dvh - 40px));
    height: fit-content;
    margin: auto;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity var(--transition-long) var(--transition-f),
      transform var(--transition-long) var(--transition-f),
      overlay var(--transition-long) var(--transition-f) allow-discrete,
      display var(--transition-long) var(--transition-f) allow-discrete;

    &:popover-open {
      opacity: 1;
      transform: scale(1);
    }

    &::backdrop {
      background-color: rgb(0 0 0 / 72%);
      opacity: 0;
      backdrop-filter: blur(6px);
      transition:
        opacity var(--transition-long) var(--transition-f),
        overlay var(--transition-long) var(--transition-f) allow-discrete,
        display var(--transition-long) var(--transition-f) allow-discrete;
    }

    &:popover-open::backdrop {
      opacity: 1;
    }
  }

  @starting-style {
    .video-popover:popover-open {
      opacity: 0;
      transform: scale(0.85);
    }

    .video-popover:popover-open::backdrop {
      opacity: 0;
    }
  }

  .video-popover__wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--border-radius12);
    background: #000;
    box-shadow: 0 24px 80px rgb(0 0 0 / 45%);

    & video {
      display: block;
      width: 100%;
      height: 100%;
      aspect-ratio: 5 / 4;
      object-fit: contain;
    }
  }

  .video-popover__close {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 10px;
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    background: rgb(17 3 3 / 70%);
    color: var(--color-white);
    place-items: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      background-color var(--transition-short) var(--transition-f),
      transform var(--transition-short) var(--transition-f);

    &:hover {
      background: rgb(17 3 3 / 90%);
      transform: scale(1.06);
    }

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: 2px;
    }

    & svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
    }
  }

  .video-popover__toggle {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-white);
    place-items: center;
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid var(--color-white);
      outline-offset: -4px;
    }
  }

  .video-popover__play {
    opacity: 0;
    transform: scale(0.5);
    pointer-events: none;
    filter: drop-shadow(0 4px 14px rgb(0 0 0 / 50%));
    transition:
      opacity var(--transition) var(--transition-f),
      transform var(--transition) var(--transition-f);

    & svg {
      display: block;
      width: clamp(56px, 8vw, 96px);
      height: clamp(56px, 8vw, 96px);
      fill: currentColor;
    }
  }

  .video-popover__wrap.is-paused .video-popover__play {
    opacity: 1;
    transform: scale(1);
  }

  .video-popover__wrap.is-closing .video-popover__play {
    opacity: 0;
    transform: scale(0.5);
  }
</style>
