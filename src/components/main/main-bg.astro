---
import { Image } from "astro:assets";

import bgDesktopImg from "./assets/bg-desktop.webp";
import bgMobileImg from "./assets/bg-mobile.webp";
import blueImg from "./assets/blue.webp";
import cloudsImg from "./assets/clouds.webp";
import forestImg from "./assets/forest.webp";
---

<div class="bg">
  <Image class="bg__image bg__image--mobile" src={bgMobileImg} alt="" />
  <Image class="bg__image bg__image--desktop" src={bgDesktopImg} alt="" />
  <Image class="blue" src={blueImg} alt="" />
  <div class="clouds">
    <Image src={cloudsImg} alt="" />
  </div>
  <Image class="forest" src={forestImg} alt="" />
</div>

<style>
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;

    .bg__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;

      &--desktop {
        display: none;

        @media (width >= 960px) {
          display: block;
        }
      }

      &--mobile {
        @media (width >= 960px) {
          display: none;
        }
      }
    }

    &::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 45%;
      opacity: 0.7;
      background-image: linear-gradient(
        0deg,
        #201d39 0%,
        rgba(47, 43, 79, 0) 100%
      );
    }

    .blue {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: auto;
    }

    .clouds {
      position: absolute;
      inset: 0;
      overflow: hidden;

      img {
        width: auto;
        max-height: 85vh;
        animation: clouds 150s linear both;
      }
    }

    .forest {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: auto;
      display: none;

      /* desktop */
      @media (width >= 960px) {
        display: block;
      }
    }
  }

  @keyframes clouds {
    from {
      transform: translate(0);
    }

    to {
      transform: translate(-100%);
    }
  }
</style>
