---
import { Image } from "astro:assets";

import cloudsImg from "./assets/clouds.webp";
---

<div class="bg">
  <div class="blue"></div>
  <div class="clouds">
    <Image src={cloudsImg} alt="" />
  </div>
  <div class="forest"></div>
</div>

<style>
  .bg {
    position: absolute;
    inset: 0;
    background-image: url("assets/bg-mobile.webp");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;

    /* desktop */
    @media (width >= 960px) {
      background-image: url("assets/bg-desktop.webp");
    }

    &::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 45%;
      opacity: 0.7;
      background-image: linear-gradient(
        0deg,
        #201d39 0%,
        rgba(47, 43, 79, 0) 100%
      );
    }

    .blue {
      position: absolute;
      inset: 0;
      background-image: url("assets/blue.webp");
      background-repeat: no-repeat;
      background-position: top;
      background-size: 100% auto;
    }

    .clouds {
      position: absolute;
      inset: 0;
      overflow: hidden;

      img {
        width: auto;
        max-height: 85vh;
        animation: clouds 150s linear both;
      }
    }

    .forest {
      position: absolute;
      inset: 0;
      background-image: url("assets/forest.webp");
      background-repeat: no-repeat;
      background-position: bottom;
      background-size: 100% auto;
      display: none;

      /* desktop */
      @media (width >= 960px) {
        display: block;
      }
    }
  }

  @keyframes clouds {
    from {
      transform: translate(0);
    }

    to {
      transform: translate(-100%);
    }
  }
</style>
