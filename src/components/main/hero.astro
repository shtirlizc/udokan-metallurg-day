---
import Logo from "../logo.astro";
import LogoLarge from "./assets/logo-large.svg";
import HeroBackgroundDesktop from "./assets/hero-bg-desktop.webp";
import HeroBackgroundMobile from "./assets/hero-bg-mobile.webp";
import HeroTexture from "./assets/hero-texture.jpg";
import HeroTitleMask from "./assets/hero-title-mask.svg?url";
import HeroTitleEdge from "./assets/hero-title-edge.svg?url";

const heroTitleShapeHref = `${HeroTitleEdge}#hero-title-shape`;
---

<section class="hero" style={`--hero-title-mask: url("${HeroTitleMask}")`}>
  <picture class="hero__background" aria-hidden="true">
    <source media="(orientation: portrait)" srcset={HeroBackgroundMobile.src} />
    <img src={HeroBackgroundDesktop.src} alt="" />
  </picture>
  <div class="hero__texture" aria-hidden="true">
    <img src={HeroTexture.src} alt="" />
  </div>

  <header class="hero__head">
    <Logo />
  </header>

  <div class="hero__body">
    <div class="hero__logo">
      <LogoLarge />
    </div>
    <div class="hero__title" aria-hidden="true">
      <span class="hero__title-glass"></span>
      <div class="hero__title-track">
        <div class="hero__title-item">
          <div class="hero__title-mark">
            <span class="hero__title-fill"></span>
            <span class="hero__title-highlight"></span>
            <svg class="hero__title-edge" viewBox="0 0 1313 241">
              <use
                href={heroTitleShapeHref}
                fill="none"
                stroke="#35150d"
                stroke-opacity="0.28"
                stroke-width="1.15"
                transform="translate(0.65 0.65)"
                vector-effect="non-scaling-stroke"></use>
              <use
                href={heroTitleShapeHref}
                fill="none"
                stroke="#fff3e7"
                stroke-opacity="0.68"
                stroke-width="0.75"
                transform="translate(-0.35 -0.35)"
                vector-effect="non-scaling-stroke"></use>
            </svg>
          </div>
        </div>
        <div class="hero__title-item">
          <div class="hero__title-mark">
            <span class="hero__title-fill"></span>
            <span class="hero__title-highlight"></span>
            <svg class="hero__title-edge" viewBox="0 0 1313 241">
              <use
                href={heroTitleShapeHref}
                fill="none"
                stroke="#35150d"
                stroke-opacity="0.28"
                stroke-width="1.15"
                transform="translate(0.65 0.65)"
                vector-effect="non-scaling-stroke"></use>
              <use
                href={heroTitleShapeHref}
                fill="none"
                stroke="#fff3e7"
                stroke-opacity="0.68"
                stroke-width="0.75"
                transform="translate(-0.35 -0.35)"
                vector-effect="non-scaling-stroke"></use>
            </svg>
          </div>
        </div>
        <div class="hero__title-item">
          <div class="hero__title-mark">
            <span class="hero__title-fill"></span>
            <span class="hero__title-highlight"></span>
            <svg class="hero__title-edge" viewBox="0 0 1313 241">
              <use
                href={heroTitleShapeHref}
                fill="none"
                stroke="#35150d"
                stroke-opacity="0.28"
                stroke-width="1.15"
                transform="translate(0.65 0.65)"
                vector-effect="non-scaling-stroke"></use>
              <use
                href={heroTitleShapeHref}
                fill="none"
                stroke="#fff3e7"
                stroke-opacity="0.68"
                stroke-width="0.75"
                transform="translate(-0.35 -0.35)"
                vector-effect="non-scaling-stroke"></use>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__foot">
    <p>
      Проект по внедрению Ценностей и «Кодекса Удокана», ведь они — это основа
      всего, что мы делаем.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 20px);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    overflow: hidden;
    background-color: #110303;
    display: grid;
    grid-template-rows: auto 1fr auto;

    @media (width >= 960px) {
      min-height: 100vh;
    }

    & .hero__background {
      position: absolute;
      inset: 0;
      display: block;
      pointer-events: none;

      & img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        object-position: center;
      }
    }

    & .hero__texture {
      position: absolute;
      z-index: 2;
      top: 0;
      left: 50%;
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
      opacity: 30%;
      transform: translateX(-50%);
      mix-blend-mode: multiply;
      pointer-events: none;

      & img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
      }
    }

    & .hero__head,
    & .hero__body,
    & .hero__foot {
      position: relative;
      z-index: 3;
    }

    & .hero__head {
      position: relative;
      padding: var(--space20);
      text-align: center;
      z-index: 10;
    }

    & .hero__body {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;

      @media (width >= 960px) {
        position: absolute;
        inset: 0;
      }

      & .hero__logo {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);

        @media (width < 960px) {
          width: 226px;
          height: 260px;
          transform: translate(-50%, -50%);

          & svg {
            display: block;
            width: 226px;
            height: 260px;
          }
        }
      }

      & .hero__title {
        --hero-title-step: 1313px;
        --hero-title-height: 241px;
        --hero-title-duration: 20s;

        position: relative;
        z-index: 1;
        width: 100%;
        height: 241px;
        overflow: hidden;
        pointer-events: none;
        animation: hero-title-shift var(--hero-title-duration) linear infinite;

        @media (width < 960px) {
          --hero-title-step: 399.65px;
          --hero-title-height: 73.35px;
          --hero-title-duration: 14s;

          position: absolute;
          top: calc(50% + 10px);
          left: 0;
          height: 74px;
          transform: translateY(-50%);
        }

        @media (width >= 960px) {
          position: absolute;
          top: calc(50% + 19.5px);
          left: 0;
          transform: translateY(-50%);
        }

        & > .hero__title-glass {
          position: absolute;
          z-index: 0;
          inset: 0;
          display: block;
          background: linear-gradient(
            to top,
            rgb(215 180 144 / 9%) 0%,
            rgb(215 180 144 / 2%) 100%
          );
          backdrop-filter: blur(24px) saturate(105%) contrast(98%);
          mask-image: var(--hero-title-mask);
          mask-position: var(--hero-title-offset) 0;
          mask-repeat: repeat-x;
          mask-size: var(--hero-title-step) var(--hero-title-height);
          -webkit-mask-image: var(--hero-title-mask);
          -webkit-mask-position: var(--hero-title-offset) 0;
          -webkit-mask-repeat: repeat-x;
          -webkit-mask-size: var(--hero-title-step) var(--hero-title-height);
        }

        .hero__title-track {
          position: relative;
          z-index: 1;
          display: flex;
          width: max-content;
          transform: translateX(var(--hero-title-offset));
        }

        .hero__title-item {
          flex: 0 0 var(--hero-title-step);
          width: var(--hero-title-step);
          height: var(--hero-title-height);
        }

        .hero__title-mark {
          position: relative;
          width: var(--hero-title-step);
          height: var(--hero-title-height);
          pointer-events: none;

          & > span {
            position: absolute;
            inset: 0;
            display: block;
            mask-image: var(--hero-title-mask);
            mask-position: 0 0;
            mask-repeat: no-repeat;
            mask-size: var(--hero-title-step) var(--hero-title-height);
            -webkit-mask-image: var(--hero-title-mask);
            -webkit-mask-position: 0 0;
            -webkit-mask-repeat: no-repeat;
            -webkit-mask-size: var(--hero-title-step) var(--hero-title-height);
            pointer-events: none;
          }

          & .hero__title-fill {
            background: linear-gradient(
              to top,
              rgb(215 180 144 / 68%) 16.998%,
              rgb(215 180 144 / 0%) 100%
            );
            filter: drop-shadow(1px 0 0 rgb(255 238 217 / 18%))
              drop-shadow(-1px 0 0 rgb(255 238 217 / 18%))
              drop-shadow(0 1px 0 rgb(55 15 7 / 10%))
              drop-shadow(0 -1px 0 rgb(255 246 235 / 14%));
          }

          & .hero__title-highlight {
            background: linear-gradient(
              135deg,
              rgb(255 248 239 / 8%) 0%,
              rgb(255 238 217 / 2%) 26%,
              transparent 50%,
              rgb(48 13 6 / 8%) 100%
            );
            mix-blend-mode: soft-light;
          }

          & .hero__title-edge {
            position: absolute;
            z-index: 2;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            overflow: visible;
            pointer-events: none;
          }

          @media (prefers-reduced-transparency: reduce) {
            & .hero__title-fill {
              background: rgb(230 193 155);
            }
          }
        }

        @media (prefers-reduced-transparency: reduce) {
          & > .hero__title-glass {
            display: none;
          }
        }
      }
    }

    & .hero__foot {
      text-align: center;
      padding: var(--space40) var(--space20) var(--space20);
      font: var(--font-text-medium);
      font-size: 16px;
      color: var(--color-white);
      max-width: 550px;
      margin-inline: auto;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        line-height: 140%;
        bottom: 72px;
        left: 50%;
        width: 555px;
        padding: 0;
        transform: translate(-50%, 100%);
      }
    }
  }

  @property --hero-title-offset {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }

  @keyframes hero-title-shift {
    to {
      --hero-title-offset: calc(0px - var(--hero-title-step));
    }
  }
</style>
