---
import Logo from "../../assets/logo.svg";
import LogoLarge from "./assets/logo-large.svg";
import HeroTexture from "./assets/hero-texture.jpg";
---

<div class="hero">
  <div class="ellipse ellipse-1"></div>
  <div class="ellipse ellipse-2"></div>
  <div class="ellipse ellipse-3"></div>
  <div class="ellipse ellipse-4"></div>
  <div class="hero__texture" aria-hidden="true">
    <img src={HeroTexture.src} alt="" />
  </div>

  <header class="hero__head">
    <Logo />
  </header>

  <div class="hero__body">
    <div class="hero__logo">
      <LogoLarge />
    </div>
    <div class="swiper hero__title" aria-hidden="true">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <p class="hero__title-text">Удокан - это вы</p>
        </div>
        <div class="swiper-slide">
          <p class="hero__title-text">Удокан - это вы</p>
        </div>
        <div class="swiper-slide">
          <p class="hero__title-text">Удокан - это вы</p>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__foot">
    <p>Поясняющий текст</p>
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    overflow: hidden;
    background-color: #110303;
    display: grid;
    grid-template-rows: auto 1fr auto;

    /* desktop */
    @media (width >= 960px) {
      min-height: 100vh;
    }

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background: transparent;
      backdrop-filter: blur(200px);
      pointer-events: none;

      /* desktop */
      @media (width >= 960px) {
        backdrop-filter: blur(300px);
      }
    }

    .ellipse {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;

      &.ellipse-1 {
        left: -8.333%;
        bottom: 0;
        transform: translateY(50%);
        width: 109.028%;
        height: 181.459%;
        background-color: #7b3d26;
      }

      &.ellipse-2 {
        left: -5.556%;
        bottom: 0;
        transform: translateY(50%);
        width: 68.681%;
        height: 122.25%;
        background-color: #b06c45;
      }

      &.ellipse-3 {
        left: -2.778%;
        bottom: 0;
        transform: translateY(35%);
        width: 37.222%;
        height: 66.255%;
        background-color: #eeb482;
      }

      &.ellipse-4 {
        bottom: 0;
        left: 5.347%;
        transform: translateY(50%);
        width: 28.125%;
        height: 36.712%;
        background-color: #fdf9d7;
      }
    }

    @media (width < 960px) {
      .ellipse {
        &.ellipse-1 {
          left: -160%;
          bottom: 0;
          width: 1570px;
          height: 1468px;
          transform: translateY(50%);
        }

        &.ellipse-2 {
          left: -100%;
          bottom: 0;
          width: 989px;
          height: 989px;
          transform: translateY(80%);
        }

        &.ellipse-3 {
          left: -100%;
          bottom: 0;
          width: 536px;
          height: 536px;
          transform: translateY(100%);
        }

        &.ellipse-4 {
          left: -100%;
          bottom: 0;
          width: 405px;
          height: 297px;
          transform: translateY(100%);
        }
      }
    }

    & .hero__texture {
      position: absolute;
      z-index: 1;
      top: 0;
      left: 50%;
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
      opacity: 30%;
      transform: translateX(-50%);
      mix-blend-mode: multiply;
      pointer-events: none;

      & img {
        position: absolute;
        top: -0.09%;
        left: 0;
        width: 100%;
        height: 143.11%;
        max-width: none;
      }
    }

    & .hero__head,
    & .hero__body,
    & .hero__foot {
      position: relative;
      z-index: 2;
    }

    & .hero__head {
      padding: var(--space20);
      text-align: center;
    }

    & .hero__body {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;

      & .hero__logo {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);

        @media (width < 960px) {
          width: 226px;
          height: 260px;

          & svg {
            display: block;
            width: 226px;
            height: 260px;
          }
        }
      }

      & .hero__title {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 241px;
        overflow: hidden;
        pointer-events: none;

        @media (width < 960px) {
          position: absolute;
          top: calc(50% + 14px);
          left: 0;
          height: 74px;
          transform: translateY(-50%);
        }

        @media (width >= 960px) {
          transform: translateY(34.5px);
        }

        .swiper-wrapper {
          transition-timing-function: linear !important;
        }

        .swiper-slide {
          width: max-content;
        }

        .hero__title-text {
          display: block;
          position: relative;
          padding-right: 70px;
          color: transparent;
          font-family: var(--font-bebas-neue-cyrillic), sans-serif;
          font-size: 230px;
          font-weight: 700;
          line-height: 105%;
          text-transform: uppercase;
          white-space: nowrap;
          background: linear-gradient(
            to top,
            rgb(244 222 200 / 32%) 0%,
            rgb(244 222 200 / 20%) 66%,
            rgb(244 222 200 / 20%) 100%
          );
          backdrop-filter: blur(14px) saturate(95%) brightness(114%)
            contrast(96%);
          -webkit-backdrop-filter: blur(14px) saturate(95%) brightness(114%)
            contrast(96%);
          -webkit-mask: linear-gradient(#fff 0 0) text;
          mask: linear-gradient(#fff 0 0) text;
          -webkit-text-stroke: 1px rgb(255 238 217 / 48%);

          @media (width < 960px) {
            padding-right: 40px;
            font-size: 70px;
            background: linear-gradient(
              to top,
              rgb(215 180 144 / 60%) 16.998%,
              rgb(215 180 144 / 0%) 100%
            );
            backdrop-filter: blur(14px) saturate(100%) brightness(100%)
              contrast(100%);
            -webkit-backdrop-filter: blur(14px) saturate(100%) brightness(100%)
              contrast(100%);
            -webkit-text-stroke-color: rgb(255 238 217 / 30%);
          }

          @media (prefers-reduced-transparency: reduce) {
            color: rgb(230 193 155);
            background: none;
            backdrop-filter: none;
            -webkit-backdrop-filter: none;
            -webkit-mask: none;
            mask: none;
          }
        }
      }
    }

    & .hero__foot {
      text-align: center;
      padding: var(--space48) var(--space20);
      font: var(--font-text-medium);
      color: var(--color-white);
    }
  }
</style>

<script>
  import { Swiper } from "swiper";
  import { Autoplay } from "swiper/modules";

  let heroTitleSwiper: Swiper | undefined;

  const initHeroTitleSwiper = () => {
    const heroTitle = document.querySelector<HTMLElement>(".hero__title");

    if (!heroTitle || heroTitleSwiper) return;

    heroTitleSwiper = new Swiper(heroTitle, {
      modules: [Autoplay],
      slidesPerView: "auto",
      loop: true,
      speed: 20000,
      allowTouchMove: false,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: false,
      },
    });
  };

  const destroyHeroTitleSwiper = () => {
    if (!heroTitleSwiper) return;

    heroTitleSwiper.destroy(true, true);
    heroTitleSwiper = undefined;
  };

  document.addEventListener("astro:page-load", initHeroTitleSwiper);
  document.addEventListener("astro:before-swap", destroyHeroTitleSwiper);
</script>
