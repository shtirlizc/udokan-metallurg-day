---
import { withBase } from "../../utils/paths";
import Tag from "../tag.astro";
import VideoBlock from "../video-block.astro";

import desktopBackground from "./assets/values-desktop.webp";
import mobileBackground from "./assets/values-mobile.webp";
import leftChart from "./assets/values-chart-1.webp";
import leftMobileChart from "./assets/values-mobile-chart-1.webp";
import rightChart from "./assets/values-chart-2.webp";
import rightMobileChart from "./assets/values-mobile-chart-2.webp";
---

<VideoBlock
  id="values"
  title={`Анимационный ролик\nНаши Ценности: от\u00A0руды до\u00A0меди!`}
  video={{
    mobile: withBase("/video/our-values-mobile.mp4"),
    desktop: withBase("/video/our-values-desktop.mp4"),
  }}
  dialogLabel="Анимационный ролик о наших ценностях"
  bg={{
    mobile: mobileBackground.src,
    desktop: desktopBackground.src,
  }}
  charts={{
    left: {
      mobile: leftMobileChart,
      desktop: leftChart,
    },
    right: {
      mobile: rightMobileChart,
      desktop: rightChart,
    },
  }}
>
  <Fragment slot="tags">
    <Tag color="#FF4400" textColor="light">Новинка</Tag>
  </Fragment>
</VideoBlock>
