---
import { Image } from "astro:assets";

import Tag from "../tag.astro";
import charsImg from "./assets/presentation-chars.webp";
---

<section class="presentation" data-chars-reveal>
  <div class="presentation__bg"></div>

  <div class="presentation__head">
    <ul>
      <Tag color="#FF4400" textColor="light">Новинка</Tag>
      <Tag color="#E88EED">Презентация</Tag>
    </ul>

    <h2>Проект по внедрению<br />Ценностей и Кодекса компании</h2>
  </div>

  <div class="presentation__chars">
    <Image src={charsImg} alt="" />
  </div>

  <a href="/pdf/presentation.pdf" target="_blank">
    Проект по внедрению Ценностей и Кодекса компании
  </a>
</section>

<script>
  function initPresentationCharsReveal() {
    const sections = document.querySelectorAll<HTMLElement>(
      ".presentation[data-chars-reveal]",
    );

    sections.forEach((section) => {
      if (section.dataset.revealInitialized) return;

      section.dataset.revealInitialized = "true";

      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting || entry.intersectionRatio < 0.8) return;

          section.classList.add("is-chars-visible");
          observer.unobserve(section);
        },
        { threshold: 0.8 },
      );

      observer.observe(section);
    });
  }

  document.addEventListener("astro:page-load", initPresentationCharsReveal);
</script>

<style>
  .presentation {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    &:hover {
      .presentation__chars {
        --chars-scale: 0.95;
      }
    }

    &.is-chars-visible .presentation__chars {
      --chars-translate-y: 0px;

      opacity: 1;
    }

    & .presentation__bg {
      position: absolute;
      inset: 0;
      background-image: url("./assets/presentation-bg.webp");
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    & .presentation__head {
      padding: var(--space20);

      /* desktop */
      @media (width >= 960px) {
        padding: 30px;
      }
    }

    ul,
    h2 {
      position: relative;
      z-index: 1;
      padding: 0;
    }

    ul {
      display: flex;
      gap: 5px;
    }

    h2 {
      margin-top: 15px;
      font-family: var(--font-bebas-neue-cyrillic), sans-serif;
      font-weight: 700;
      font-size: 35px;
      line-height: 88%;
      text-transform: uppercase;
      color: var(--color-white);

      /* desktop */
      @media (width >= 960px) {
        font-size: 40px;
        line-height: 105%;
      }
    }

    & .presentation__chars {
      --chars-translate-y: clamp(48px, 8vw, 120px);
      --chars-scale: 1;

      flex-grow: 1;
      position: relative;
      z-index: 1;
      font-size: 0;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      margin-top: -10vw;
      opacity: 0;
      transform: translateY(var(--chars-translate-y)) scale(var(--chars-scale));
      transition:
        opacity calc(1.5 * var(--transition-long)) var(--transition-f),
        transform calc(1.5 * var(--transition-long)) var(--transition-f);
      transform-origin: center bottom;

      /* tablet */
      @media (width >= 768px) {
        margin-top: -10vw;
      }

      /* desktop */
      @media (width >= 960px) {
        margin-top: 0;
      }

      img {
        width: 100%;
        height: auto;
        object-fit: contain;
        max-width: 460px;
      }

      @media (prefers-reduced-motion: reduce) {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    a {
      position: absolute;
      inset: 0;
      z-index: 2;
      font-size: 0;
    }
  }
</style>
