---
import { Image } from "astro:assets";

import Tag from "../tag.astro";
import charsImg from "./assets/presentation-chars.webp";
---

<section class="presentation">
  <div class="presentation__bg"></div>

  <div class="presentation__head">
    <ul>
      <Tag color="#FF4400" textColor="light">Новинка</Tag>
      <Tag color="#E88EED">Презентация</Tag>
    </ul>

    <h2>Проект по внедрению Ценностей и Кодекса компании</h2>
  </div>

  <div class="presentation__chars">
    <Image src={charsImg} alt="" />
  </div>

  <a href="/pdf/presentation.pdf" target="_blank">
    Проект по внедрению Ценностей и Кодекса компании
  </a>
</section>

<style>
  .presentation {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    &:hover {
      .presentation__chars {
        transform: scale(0.95);
      }
    }

    & .presentation__bg {
      position: absolute;
      inset: 0;
      background-image: url("./assets/presentation-bg.webp");
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    & .presentation__head {
      padding: var(--space20);

      /* desktop */
      @media (width >= 960px) {
        padding: 30px;
      }
    }

    ul,
    h2 {
      position: relative;
      z-index: 1;
      padding: 0;
    }

    ul {
      display: flex;
      gap: 5px;
    }

    h2 {
      margin-top: 15px;
      font-family: var(--font-bebas-neue-cyrillic), sans-serif;
      font-weight: 700;
      font-size: 35px;
      line-height: 90%;
      text-transform: uppercase;
      color: var(--color-white);

      /* desktop */
      @media (width >= 960px) {
        font-size: 40px;
        line-height: 105%;
        text-transform: none;
      }
    }

    & .presentation__chars {
      flex-grow: 1;
      position: relative;
      z-index: 1;
      font-size: 0;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      transform: scale(1);
      transition: transform var(--transition-long) ease-in-out;
      transform-origin: center bottom;

      img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }
    }

    a {
      position: absolute;
      inset: 0;
      z-index: 2;
      font-size: 0;
    }
  }
</style>
