---
import Hero from "../components/main/hero.astro";
import MainLayout from "../layouts/main.astro";
import MetallurgistDay from "../components/main/metallurgist-day.astro";
import Congratulation from "../components/main/congratulation.astro";
import Presentation from "../components/main/presentation.astro";
import OurValues from "../components/main/our-values.astro";
import Safety from "../components/main/safety.astro";
import CodexArticle from "../components/main/codex-article.astro";
---

<MainLayout>
  <div class="grid">
    <Hero />

    <div class="grid__cols">
      <Safety />
      <CodexArticle />
    </div>

    <OurValues />

    <div class="grid__one-two-cols">
      <Presentation />
      <MetallurgistDay />
    </div>

    <Congratulation />
  </div>
</MainLayout>

<style>
  .grid {
    & .grid__cols {
      /* desktop */
      @media (width >= 960px) {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
    }

    & .grid__one-two-cols {
      /* desktop */
      @media (width >= 960px) {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      /* widescreen */
      @media (width >= 1200px) {
        grid-template-columns: 1fr 2fr;
      }
    }
  }
</style>
