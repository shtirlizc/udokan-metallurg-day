---
import { getCollection } from "astro:content";

import Header from "../../components/metallurgist-day/header.astro";
import ResultMessage from "../../components/metallurgist-day/result-message.astro";
import MainLayout from "../../layouts/main.astro";
import MetallurgistDayLayout from "../../layouts/metallurgist-day.astro";

const questions = await getCollection("metallurgistQuestions");
const questionsCount = questions.length;
---

<MainLayout>
  <MetallurgistDayLayout>
    <Header isCentered />
    <main class="content">
      <ResultMessage questionsCount={questionsCount} />
    </main>
    <div></div>
  </MetallurgistDayLayout>
</MainLayout>

<style>
  .content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--space8);

    .message {
      max-width: 473px;
      border-radius: 24px;
      background-color: var(--white-0);
      padding: var(--space16);
      width: calc(100vw - 16px);

      /* desktop */
      @media (width >= 960px) {
        padding: var(--space32);
      }
    }
  }
</style>
