---
import Footer from "../../components/metallurgist-day/footer.astro";
import Header from "../../components/metallurgist-day/header.astro";
import Link from "../../components/metallurgist-day/link.astro";
import { QUIZ_STORAGE_KEYS } from "../../config/quizzes";
import MainLayout from "../../layouts/main.astro";
import MetallurgistDayLayout from "../../layouts/metallurgist-day.astro";
---

<MainLayout>
  <MetallurgistDayLayout>
    <Header />

    <main
      class="content"
      data-quiz-home="/день-металлурга"
      data-quiz-storage-key={QUIZ_STORAGE_KEYS.metallurgistDay}
    >
      <h1>«Удокан — это вы»</h1>
      <p>
        Мы на «Удокане» отмечаем профессиональный праздник — День металлурга.
        <br />
        Один из подарков — эта интерактивная игра. Погрузитесь в атмосферу металлургического
        производства, пройдите задания, почувствуйте свою причастность к общему делу
        и получите заслуженное признание. Потому что «Удокан» — это вы!
      </p>
      <div class="main__play">
        <Link href="/день-металлурга/1">Играть</Link>
      </div>
    </main>

    <Footer />
  </MetallurgistDayLayout>
</MainLayout>

<script>
  import "../../scripts/quiz-home";
</script>

<style>
  .content {
    color: var(--color-white);
    max-width: 714px;
    margin-inline: auto;
    padding: 6px var(--space8);
    z-index: 1;

    /* desktop */
    @media (width >= 960px) {
      text-align: center;
      padding: 0;
    }

    h1 {
      font: var(--font-title-1);
    }

    p {
      margin-top: 14px;
      font: var(--font-text-regular);
    }

    & .main__play {
      margin-top: 25px;

      /* desktop */
      @media (width >= 960px) {
        margin-top: 34px;
      }
    }
  }
</style>
