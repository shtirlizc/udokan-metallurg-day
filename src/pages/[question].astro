---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";
import { charsTransition } from "../transitions/chars";
import { questionBackgroundTransition } from "../transitions/question-background";
import { quizPanelTransition } from "../transitions/quiz-panel";
import MetrikaNoscript from "../components/metrika-noscript.astro";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question: CollectionEntry<"question">) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
const [mobileBackground, desktopBackground, mobileChars, desktopChars] =
  await Promise.all([
    getImage({ src: mobile, format: "webp", quality: 100 }),
    getImage({ src: desktop, format: "webp", quality: 100 }),
    charsMobile && getImage({ src: charsMobile, format: "webp", quality: 100 }),
    charsDesktop &&
      getImage({ src: charsDesktop, format: "webp", quality: 100 }),
  ]);

const {
  loading: _mobileBackgroundLoading,
  decoding: _mobileBackgroundDecoding,
  ...mobileBackgroundAttributes
} = mobileBackground.attributes;
const {
  loading: _mobileCharsLoading,
  decoding: _mobileCharsDecoding,
  ...mobileCharsAttributes
} = mobileChars.attributes;
---

<!--
  The question scene owns three independently animated View Transition layers.
  Do not also snapshot this wrapper: on Safari that creates an additional
  full-viewport old snapshot and the first outgoing scene can be dropped.
-->
<html lang="ru">
  <Head />

  <body>
    <MetrikaNoscript />
    <div class="question">
      <div class="question__body">
        <div class="bg">
          <div
            class="bg-images"
            transition:name="question-background"
            transition:animate={questionBackgroundTransition}
          >
            <picture class="bg__image" data-transition-image>
              <source
                media="(min-width: 960px)"
                srcset={desktopBackground.src}
                width="1440"
                height="810"
                type="image/webp"
              />
              <img
                src={mobileBackground.src}
                alt=""
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                {...mobileBackgroundAttributes}
              />
            </picture>
          </div>

          <div
            class="bg-chars"
            transition:name="chars"
            transition:animate={charsTransition}
          >
            <picture data-transition-image>
              <source
                media="(min-width: 960px)"
                srcset={desktopChars.src}
                width="1440"
                height="810"
                type="image/webp"
              />
              <img
                src={mobileChars.src}
                alt=""
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                {...mobileCharsAttributes}
              />
            </picture>
          </div>
        </div>
      </div>
      <div
        class="quiz-panel"
        transition:name="quiz-panel"
        transition:animate={quizPanelTransition}
      >
        <Quiz question={question} />
      </div>
    </div>
  </body>
</html>

<style>
  .question {
    position: relative;
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-rows: none;
      grid-template-columns: 473px 1fr;
      overflow: hidden;
      padding: 10px;
    }

    & .question__body {
      display: flex;
      justify-content: center;
      align-items: center;
      aspect-ratio: 1;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        aspect-ratio: auto;
      }
    }

    .bg {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;

      .bg-images {
        position: absolute;
        inset: 0;
        overflow: hidden;
        transform: scale(1);
        transform-origin: center;
      }

      .bg-chars {
        position: absolute;
        inset: 0;
        overflow: hidden;
        transform: scale(1);
        transform-origin: center;
      }

      .bg__image,
      .bg-chars picture {
        position: absolute;
        inset: 0;
        display: block;
      }

      .bg__image img,
      .bg-chars img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .bg-chars {
        picture {
          pointer-events: none;
        }
      }
    }
  }

  .quiz-panel {
    position: relative;
    min-height: 0;
    overflow: hidden;
    margin-top: -15px;

    &.loading {
      cursor: progress;
      pointer-events: none;
    }

    /* desktop */
    @media (width >= 960px) {
      height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      border-radius: 0;
      padding: 0;
      background-color: transparent;
      margin-top: 0;
    }
  }
</style>
