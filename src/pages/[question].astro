---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";
import { charsTransition } from "../transitions/chars";
import { pageSlide } from "../transitions/page-slide";
import { questionBackgroundTransition } from "../transitions/question-background";
import { quizPanelTransition } from "../transitions/quiz-panel";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question: CollectionEntry<"question">) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
const [mobileBackground, desktopBackground, mobileChars, desktopChars] =
  await Promise.all([
    getImage({ src: mobile, format: "webp" }),
    getImage({ src: desktop, format: "webp" }),
    charsMobile && getImage({ src: charsMobile, format: "webp" }),
    charsDesktop && getImage({ src: charsDesktop, format: "webp" }),
  ]);
---

<html lang="ru" transition:name="root" transition:animate={pageSlide}>
  <Head />

  <body>
    <div class="question">
      <div class="question__body">
        <div class="bg">
          <div
            class="bg-images"
            transition:name="question-background"
            transition:animate={questionBackgroundTransition}
          >
            <picture class="bg__image">
              <source
                media="(min-width: 960px)"
                srcset={desktopBackground.src}
                width="1440"
                height="810"
                type="image/webp"
              />
              <img
                src={mobileBackground.src}
                {...mobileBackground.attributes}
                alt=""
                loading="eager"
                decoding="sync"
              />
            </picture>
          </div>
          {
            desktopChars && mobileChars && (
              <div
                class="bg-chars"
                transition:name="chars"
                transition:animate={charsTransition}
              >
                <picture>
                  <source
                    media="(min-width: 960px)"
                    srcset={desktopChars.src}
                    width="1440"
                    height="810"
                    type="image/webp"
                  />
                  <img
                    src={mobileChars.src}
                    {...mobileChars.attributes}
                    alt=""
                    loading="eager"
                    decoding="sync"
                  />
                </picture>
              </div>
            )
          }
        </div>
      </div>
      <div
        class="quiz-panel"
        transition:name="quiz-panel"
        transition:animate={quizPanelTransition}
      >
        <Quiz question={question} />
      </div>
    </div>
  </body>
</html>

<style>
  .question {
    position: relative;
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-rows: 4fr 6fr;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-rows: none;
      grid-template-columns: 473px 1fr;
      padding: 10px;
    }

    & .question__body {
      display: flex;
      justify-content: center;
      align-items: center;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        inset: 0;
      }
    }

    .bg {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;

      .bg-images {
        position: absolute;
        inset: 0;
        overflow: hidden;
        transform: scale(1.1);
        transform-origin: center;
      }

      .bg-chars {
        position: absolute;
        inset: 0;
        overflow: hidden;
        transform: scale(1.1);
        transform-origin: center;
      }

      .bg__image,
      .bg-chars picture {
        position: absolute;
        inset: 0;
        display: block;
      }

      .bg__image img,
      .bg-chars img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .bg-chars {
        picture {
          pointer-events: none;
        }
      }
    }
  }

  .quiz-panel {
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
  }
</style>
