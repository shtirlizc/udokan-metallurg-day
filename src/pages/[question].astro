---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";
import { charsTransition } from "../transitions/chars";
import { pageSlide } from "../transitions/page-slide";
import { questionBackgroundTransition } from "../transitions/question-background";
import { quizPanelTransition } from "../transitions/quiz-panel";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
const [mobileBackground, desktopBackground, mobileChars, desktopChars] =
  await Promise.all([
    getImage({ src: mobile, format: "webp", quality: 75 }),
    getImage({ src: desktop, format: "webp", quality: 75 }),
    charsMobile && getImage({ src: charsMobile, format: "webp", quality: 75 }),
    charsDesktop && getImage({ src: charsDesktop, format: "webp", quality: 75 }),
  ]);
---

<html lang="ru" transition:name="root" transition:animate={pageSlide}>
  <Head />

  <body>
    <div class="question">
      <div class="bg">
        <div
          class="bg-images"
          transition:name="question-background"
          transition:animate={questionBackgroundTransition}
        >
          <picture class="bg__image">
            <source
              media="(min-width: 960px)"
              srcset={desktopBackground.src}
              type="image/webp"
            />
            <img
              src={mobileBackground.src}
              {...mobileBackground.attributes}
              alt=""
              loading="eager"
              decoding="sync"
            />
          </picture>
        </div>
        {
          desktopChars && mobileChars && (
            <div
              class="bg-chars"
              transition:name="chars"
              transition:animate={charsTransition}
            >
              <picture>
                <source
                  media="(min-width: 960px)"
                  srcset={desktopChars.src}
                  type="image/webp"
                />
                <img
                  src={mobileChars.src}
                  {...mobileChars.attributes}
                  alt=""
                  loading="eager"
                  decoding="sync"
                />
              </picture>
            </div>
          )
        }
      </div>
      <div
        class="quiz-panel"
        transition:name="quiz-panel"
        transition:animate={quizPanelTransition}
      >
        <Quiz question={question} />
      </div>
    </div>
  </body>
</html>

<style>
  .question {
    position: relative;
    height: 100dvh;
    display: grid;
    grid-template-rows: 4fr 6fr;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-columns: 473px 1fr;
      grid-template-rows: none;
      padding: 10px;
    }

    .bg {
      position: relative;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .bg-images {
        position: absolute;
        inset: 0;
        transform: scale(1.2);
        transform-origin: center;

        .bg__image {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
          }
        }
      }

      .bg-chars {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;

        picture {
          width: 100%;
          height: 100%;
          display: block;
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }
</style>
