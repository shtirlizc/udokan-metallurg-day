---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";
import { charsTransition } from "../transitions/chars";
import { pageSlide } from "../transitions/page-slide";
import { questionBackgroundTransition } from "../transitions/question-background";
import { quizPanelTransition } from "../transitions/quiz-panel";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
---

<html lang="ru" transition:name="root" transition:animate={pageSlide}>
  <Head />

  <body>
    <div class="question">
      <div class="bg">
        <div
          class="bg-images"
          transition:name="question-background"
          transition:animate={questionBackgroundTransition}
        >
          <Image
            class="bg__image bg__image--mobile"
            src={mobile}
            alt=""
            loading="eager"
            decoding="sync"
          />
          <Image
            class="bg__image bg__image--desktop"
            src={desktop}
            alt=""
            loading="eager"
            decoding="sync"
          />
        </div>
        {
          charsDesktop && charsMobile && (
            <div
              class="bg-chars"
              transition:name="chars"
              transition:animate={charsTransition}
            >
              <div class="desktop">
                <Image
                  src={charsDesktop}
                  alt=""
                  loading="eager"
                  decoding="sync"
                />
              </div>
              <div class="mobile">
                <Image
                  src={charsMobile}
                  alt=""
                  loading="eager"
                  decoding="sync"
                />
              </div>
            </div>
          )
        }
      </div>
      <div
        class="quiz-panel"
        transition:name="quiz-panel"
        transition:animate={quizPanelTransition}
      >
        <Quiz question={question} />
      </div>
    </div>
  </body>
</html>

<style>
  .question {
    position: relative;
    height: 100dvh;
    display: grid;
    grid-template-rows: 4fr 6fr;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-columns: 473px 1fr;
      grid-template-rows: none;
      padding: 10px;
    }

    .bg {
      position: relative;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .bg-images {
        position: absolute;
        inset: 0;
        transform: scale(1.2);
        transform-origin: center;

        .bg__image {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;

          &--desktop {
            display: none;

            @media (width >= 960px) {
              display: block;
            }
          }

          &--mobile {
            @media (width >= 960px) {
              display: none;
            }
          }
        }
      }

      .bg-chars {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;

        .mobile {
          width: 100%;
          height: 100%;

          /* desktop */
          @media (width >= 960px) {
            display: none;
          }
        }

        .desktop {
          width: 100%;
          height: 100%;
          display: none;

          /* desktop */
          @media (width >= 960px) {
            display: block;
          }
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }
</style>
