---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
---

<html lang="ru">
  <Head />

  <body>
    <div class="question">
      <div class="bg">
        {
          charsDesktop && charsMobile && (
            <div class="bg-chars">
              <div class="desktop">
                <Image src={charsDesktop} alt="" />
              </div>
              <div class="mobile">
                <Image src={charsMobile} alt="" />
              </div>
            </div>
          )
        }
      </div>
      <Quiz question={question} />
    </div>
  </body>
</html>

<style
  define:vars={{
    questionBgMobile: `url("${mobile.src}")`,
    questionBgDesktop: `url("${desktop.src}")`,
  }}
>
  .question {
    position: relative;
    height: 100dvh;
    display: grid;
    grid-template-rows: 4fr 6fr;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-columns: 473px 1fr;
      grid-template-rows: none;
      padding: 10px;
    }

    .bg {
      position: relative;
      background-image: var(--questionBgMobile);
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: var(--questionBgDesktop);
      }

      .bg-chars {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;

        .mobile {
          width: 100%;
          height: 100%;

          /* desktop */
          @media (width >= 960px) {
            display: none;
          }
        }

        .desktop {
          width: 100%;
          height: 100%;
          display: none;

          /* desktop */
          @media (width >= 960px) {
            display: block;
          }
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }
</style>
