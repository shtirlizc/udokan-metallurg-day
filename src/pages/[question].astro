---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
---

<html lang="ru">
  <Head />

  <body>
    <div class="question">
      <div class="bg">
        {
          charsDesktop && charsMobile && (
            <div class="bg-chars">
              <div class="desktop">
                <Image src={charsDesktop} alt="" />
              </div>
              <div class="mobile">
                <Image src={charsMobile} alt="" />
              </div>
            </div>
          )
        }
      </div>
      <Quiz question={question} />
    </div>
  </body>
</html>

<script>
  const bg = document.querySelector<HTMLElement>(".bg");
  const bgChars = document.querySelector<HTMLElement>(".bg-chars");

  if (bg && bgChars) {
    const setParallax = (x: number, y: number) => {
      bg.style.transform = `translate(${-x * 18}px, ${-y * 18}px) scale(1.04)`;
      bgChars.style.transform = `translate(${-x * 30}px, ${-y * 30}px)`;
    };

    const move = (event: MouseEvent) => {
      const rect = bgChars.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;

      setParallax(x, y);
    };

    const reset = () => {
      bg.style.transform = "translate(0, 0) scale(1)";
      bgChars.style.transform = "translate(0, 0)";
    };

    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      bgChars.addEventListener("mousemove", move);
      bgChars.addEventListener("mouseleave", reset);
    } else if ("DeviceOrientationEvent" in window) {
      const clamp = (value: number, limit: number) =>
        Math.max(-limit, Math.min(limit, value));

      const onOrientation = (event: DeviceOrientationEvent) => {
        // На телефоне реагируем только на наклон влево и вправо.
        const x = clamp(event.gamma ?? 0, 30) / 60;
        setParallax(x, 0);
      };

      const startOrientation = () => {
        window.addEventListener("deviceorientation", onOrientation, {
          passive: true,
        });
      };

      const orientationEvent =
        DeviceOrientationEvent as typeof DeviceOrientationEvent & {
          requestPermission?: () => Promise<"granted" | "denied">;
        };

      // Safari требует запросить доступ к датчикам после действия пользователя.
      if (orientationEvent.requestPermission) {
        window.addEventListener(
          "pointerdown",
          async () => {
            if ((await orientationEvent.requestPermission?.()) === "granted") {
              startOrientation();
            }
          },
          { once: true },
        );
      } else {
        startOrientation();
      }
    }
  }
</script>

<style
  define:vars={{
    questionBgMobile: `url("${mobile.src}")`,
    questionBgDesktop: `url("${desktop.src}")`,
  }}
>
  .question {
    position: relative;
    height: 100dvh;
    display: grid;
    grid-template-rows: 4fr 6fr;
    overflow: hidden;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-columns: 473px 1fr;
      grid-template-rows: none;
      padding: 10px;
    }

    .bg {
      position: relative;
      transition: transform 180ms ease-out;
      background-image: var(--questionBgMobile);
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: var(--questionBgDesktop);
      }

      .bg-chars {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        transition: transform 220ms ease-out;
        opacity: 0;
        animation: bg-chars-appear 600ms ease-out forwards;

        .mobile {
          width: 100%;
          height: 100%;

          /* desktop */
          @media (width >= 960px) {
            display: none;
          }
        }

        .desktop {
          width: 100%;
          height: 100%;
          display: none;

          /* desktop */
          @media (width >= 960px) {
            display: block;
          }
        }

        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }
    }
  }

  @keyframes bg-chars-appear {
    from {
      left: -60px;
      opacity: 0;
    }

    to {
      left: 0;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .question .bg .bg-chars {
      animation: none;
      opacity: 1;
    }
  }
</style>
