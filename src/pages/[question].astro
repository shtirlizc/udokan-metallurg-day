---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Head from "../components/head.astro";
import Quiz from "../components/quiz.astro";
import { charsTransition } from "../transitions/chars";
import { pageSlide } from "../transitions/page-slide";
import { questionBackgroundTransition } from "../transitions/question-background";
import { quizPanelTransition } from "../transitions/quiz-panel";

export async function getStaticPaths() {
  const questions = await getCollection("question");

  return questions.map((question: CollectionEntry<"question">) => ({
    params: { question: question.id },
    props: { question },
  }));
}

interface Props {
  question: CollectionEntry<"question">;
}

const { question } = Astro.props;
const { backgrounds } = question.data;
const { mobile, desktop, charsMobile, charsDesktop } = backgrounds;
const [mobileBackground, desktopBackground, mobileChars, desktopChars] =
  await Promise.all([
    getImage({ src: mobile, format: "webp", quality: 100 }),
    getImage({ src: desktop, format: "webp", quality: 100 }),
    charsMobile && getImage({ src: charsMobile, format: "webp", quality: 100 }),
    charsDesktop &&
      getImage({ src: charsDesktop, format: "webp", quality: 100 }),
  ]);
---

<html lang="ru" transition:name="root" transition:animate={pageSlide}>
  <Head />

  <body>
    <div class="question">
      <div class="question__body">
        <div class="bg">
          <div
            class="bg-images"
            transition:name="question-background"
            transition:animate={questionBackgroundTransition}
          >
            <picture class="bg__image">
              <source
                media="(min-width: 960px)"
                srcset={desktopBackground.src}
                width="1440"
                height="810"
                type="image/webp"
              />
              <img
                src={mobileBackground.src}
                {...mobileBackground.attributes}
                alt=""
                loading="eager"
                decoding="sync"
              />
            </picture>
          </div>

          <div
            class="bg-chars"
            transition:name="chars"
            transition:animate={charsTransition}
          >
            <picture>
              <source
                media="(min-width: 960px)"
                srcset={desktopChars.src}
                width="1440"
                height="810"
                type="image/webp"
              />
              <img
                src={mobileChars.src}
                {...mobileChars.attributes}
                alt=""
                loading="eager"
                decoding="sync"
              />
            </picture>
          </div>
        </div>
      </div>
      <div
        class="quiz-panel"
        transition:name="quiz-panel"
        transition:animate={quizPanelTransition}
      >
        <span class="quiz-panel__scroll-cue" aria-hidden="true"></span>
        <Quiz question={question} />
      </div>
    </div>
  </body>
</html>

<style>
  .question {
    position: relative;
    width: 100%;
    height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow-x: hidden;
    overflow-y: auto;

    /* desktop */
    @media (width >= 960px) {
      height: 100vh;
      grid-template-rows: none;
      grid-template-columns: 473px 1fr;
      overflow: hidden;
      padding: 10px;
    }

    & .question__body {
      display: flex;
      justify-content: center;
      align-items: center;
      aspect-ratio: 1;

      /* desktop */
      @media (width >= 960px) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        aspect-ratio: auto;
      }
    }

    .bg {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;

      .bg-images {
        position: absolute;
        inset: 0;
        overflow: hidden;
        transform: scale(1);
        transform-origin: center;
      }

      .bg-chars {
        position: absolute;
        inset: 0;
        overflow: hidden;
        transform: scale(1);
        transform-origin: center;
      }

      .bg__image,
      .bg-chars picture {
        position: absolute;
        inset: 0;
        display: block;
      }

      .bg__image img,
      .bg-chars img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .bg-chars {
        picture {
          pointer-events: none;
        }
      }
    }
  }

  .quiz-panel {
    position: relative;
    border-radius: var(--border-radius12) var(--border-radius12) 0 0;
    padding: var(--space20) var(--space16) var(--space16);
    background-color: var(--white-0);
    margin-top: -15px;

    & .quiz-panel__scroll-cue {
      position: absolute;
      top: var(--space8);
      right: var(--space16);
      width: 18px;
      height: 24px;
      pointer-events: none;
      opacity: 0.7;

      &::before,
      &::after {
        content: "";
        position: absolute;
        left: 5px;
        width: 8px;
        height: 8px;
        border-right: 2px solid currentcolor;
        border-bottom: 2px solid currentcolor;
        transform: rotate(45deg);
      }

      &::before {
        top: 3px;
      }

      &::after {
        top: 10px;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      & .quiz-panel__scroll-cue {
        animation: quiz-panel-scroll-cue 1.6s ease-in-out infinite;
        will-change: transform, opacity;
      }
    }

    /* desktop */
    @media (width >= 960px) {
      height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      border-radius: 0;
      padding: 0;
      background-color: transparent;
      margin-top: 0;

      & .quiz-panel__scroll-cue {
        display: none;
      }
    }
  }

  @keyframes quiz-panel-scroll-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.35;
    }

    45% {
      transform: translateY(6px);
      opacity: 0.85;
    }
  }
</style>
