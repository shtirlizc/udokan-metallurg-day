---
import Head from "../components/head.astro";
import MetrikaNoscript from "../components/metrika-noscript.astro";

interface Props {
  title?: string;
  description?: string;
  coverSrc?: string;
  coverAlt?: string;
}

const { title, description, coverSrc, coverAlt } = Astro.props;
---

<html lang="ru">
  <Head
    title={title}
    description={description}
    coverSrc={coverSrc}
    coverAlt={coverAlt}
  />

  <body>
    <MetrikaNoscript />

    <slot />
  </body>
</html>
