---
import Head from "../components/head.astro";
import MetrikaNoscript from "../components/metrika-noscript.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<html lang="ru">
  <Head title={title} description={description} />

  <body>
    <MetrikaNoscript />

    <slot />
  </body>
</html>
