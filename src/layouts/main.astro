---
import Head from "../components/head.astro";
import MainBg from "../components/main/main-bg.astro";
import { pageSlide } from "../transitions/page-slide";
---

<html lang="ru" transition:name="root" transition:animate={pageSlide}>
  <Head />

  <body>
    <div class="main">
      <MainBg transition:persist="main-background" />

      <slot />
    </div>
  </body>
</html>

<style>
  .main {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100dvh;
  }
</style>
